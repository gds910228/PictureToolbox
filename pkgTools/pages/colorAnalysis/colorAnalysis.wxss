/* pages/colorAnalysis/colorAnalysis.wxss */
.page-container {
  min-height: 100vh;
  padding: var(--space-lg);
  box-sizing: border-box;
  position: relative;
  z-index: 1;
}

/* 页头 */
.page-header {
  margin-bottom: var(--space-md);
}
.header-line {
  width: 64rpx;
  height: 6rpx;
  background: var(--gradient-neon);
  border-radius: 4rpx;
  margin-bottom: var(--space-sm);
  box-shadow: var(--shadow-neon);
}
.header-title {
  display: block;
  font-family: var(--font-family-display);
  font-size: 44rpx;
  font-weight: 700;
  color: var(--color-white);
  letter-spacing: 2rpx;
}
.header-sub {
  display: block;
  margin-top: 6rpx;
  font-size: 24rpx;
  color: var(--color-gray-500);
}

.hidden-canvas {
  position: fixed;
  left: -9999rpx;
  top: -9999rpx;
  width: 240rpx;
  height: 240rpx;
}

/* 卡片 */
.section {
  margin-bottom: var(--space-md);
}
.section-title {
  display: flex;
  align-items: center;
  justify-content: space-between;
  font-size: 30rpx;
  font-weight: 600;
  color: var(--color-neon-cyan);
  margin-bottom: var(--space-sm);
}
.section-count {
  font-size: 24rpx;
  color: var(--color-gray-500);
  font-weight: 400;
}

.hint {
  font-size: 22rpx;
  color: var(--color-gray-500);
  margin-top: var(--space-sm);
  line-height: 1.5;
}

/* 选图区 */
.src-preview {
  width: 100%;
  border-radius: var(--radius-md);
  overflow: hidden;
  background: repeating-conic-gradient(rgba(255,255,255,0.04) 0% 25%, transparent 0% 50%) 0 0 / 32rpx 32rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: var(--space-sm);
  min-height: 200rpx;
}
.src-img {
  width: 100%;
  max-height: 520rpx;
}
.src-meta {
  font-size: 22rpx;
  color: var(--color-gray-500);
  margin-bottom: var(--space-sm);
}
.src-actions {
  display: flex;
  gap: var(--space-sm);
}
.src-btn {
  flex: 1;
  height: 80rpx;
  line-height: 80rpx;
  font-size: 28rpx;
}
.src-btn.danger {
  color: var(--color-hot-magenta);
  border-color: rgba(255, 0, 128, 0.5);
}

/* 参数行 */
.opt-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-top: var(--space-sm);
}
.opt-label {
  width: 140rpx;
  font-size: 26rpx;
  color: var(--color-gray-200);
  flex-shrink: 0;
}
.count-slider {
  flex: 1;
  margin: 0 12rpx;
}
.count-text {
  width: 110rpx;
  text-align: right;
  font-size: 24rpx;
  color: var(--color-neon-cyan);
  flex-shrink: 0;
}

/* 分析中 */
.analyzing-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
}
.loading-dot {
  width: 20rpx;
  height: 20rpx;
  border-radius: 50%;
  background: var(--color-neon-cyan);
  box-shadow: 0 0 12rpx rgba(0, 240, 255, 0.7);
  animation: ca-pulse 1s ease-in-out infinite;
}
@keyframes ca-pulse {
  0%, 100% { opacity: 0.3; transform: scale(0.8); }
  50% { opacity: 1; transform: scale(1.2); }
}
.analyzing-text {
  font-size: 26rpx;
  color: var(--color-gray-200);
}

/* 视觉色卡条 */
.palette-strip {
  display: flex;
  width: 100%;
  height: 180rpx;
  border-radius: var(--radius-md);
  overflow: hidden;
  margin-bottom: var(--space-md);
  border: 1rpx solid rgba(0, 240, 255, 0.15);
}
.palette-block {
  flex: 1;
  position: relative;
  display: flex;
  align-items: flex-end;
  justify-content: center;
  padding-bottom: 10rpx;
}
.palette-pct {
  font-size: 20rpx;
  font-weight: 600;
}

/* 详细列表 */
.color-list {
  display: flex;
  flex-direction: column;
  gap: var(--space-sm);
}
.color-row {
  display: flex;
  align-items: center;
  gap: var(--space-sm);
  padding: 16rpx;
  border-radius: var(--radius-md);
  background: rgba(255, 255, 255, 0.03);
  border: 1rpx solid rgba(255, 255, 255, 0.06);
}
.color-row:active {
  background: rgba(0, 240, 255, 0.08);
}
.color-swatch {
  width: 96rpx;
  height: 96rpx;
  border-radius: var(--radius-sm);
  flex-shrink: 0;
  border: 1rpx solid rgba(255, 255, 255, 0.15);
}
.color-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 4rpx;
  min-width: 0;
}
.color-hex {
  font-size: 30rpx;
  font-weight: 700;
  color: var(--color-white);
  letter-spacing: 1rpx;
}
.color-sub {
  font-size: 22rpx;
  color: var(--color-gray-500);
}
.color-pct-wrap {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 8rpx;
  width: 140rpx;
  flex-shrink: 0;
}
.color-pct-num {
  font-size: 24rpx;
  color: var(--color-neon-cyan);
  font-weight: 600;
}
.color-pct-bar {
  width: 100%;
  height: 8rpx;
  border-radius: 4rpx;
  background: rgba(255, 255, 255, 0.08);
  overflow: hidden;
}
.color-pct-fill {
  height: 100%;
  background: var(--gradient-neon);
  border-radius: 4rpx;
}
.copy-icon {
  font-size: 22rpx;
  color: var(--color-gray-500);
  padding: 6rpx 14rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.12);
  border-radius: var(--radius-sm);
  flex-shrink: 0;
}

/* 操作 */
.palette-actions {
  display: flex;
  gap: var(--space-sm);
  margin-top: var(--space-md);
}
.action-btn {
  flex: 1;
  height: 84rpx;
  line-height: 84rpx;
  font-size: 28rpx;
}

/* 导出结果 */
.preview-wrap {
  width: 100%;
  border-radius: var(--radius-md);
  overflow: hidden;
  background:
    repeating-conic-gradient(rgba(255,255,255,0.04) 0% 25%, transparent 0% 50%) 0 0 / 32rpx 32rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: var(--space-sm);
}
.preview-img {
  width: 100%;
}
.result-meta {
  font-size: 24rpx;
  color: var(--color-gray-500);
  margin-bottom: var(--space-sm);
}
.save-btn { margin-top: 0; }
