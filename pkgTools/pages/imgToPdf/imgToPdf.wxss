/* pages/imgToPdf/imgToPdf.wxss */

.container {
  min-height: 100vh;
  padding: 24rpx;
  background: transparent;
  box-sizing: border-box;
}

/* 头部 */
.hero {
  padding: 32rpx 16rpx 16rpx;
  margin-bottom: 24rpx;
}
.hero-title {
  font-size: 44rpx;
  color: #fff;
  font-weight: 700;
  letter-spacing: 2rpx;
}
.hero-sub {
  font-size: 26rpx;
  color: rgba(255,255,255,0.55);
  margin-top: 12rpx;
}

/* 图片列表 */
.image-list {
  background: rgba(0,240,255,0.04);
  border: 2rpx solid rgba(0,240,255,0.18);
  border-radius: 24rpx;
  padding: 16rpx;
  margin-bottom: 24rpx;
}
.list-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 8rpx 12rpx 16rpx;
}
.list-title {
  font-size: 28rpx;
  color: #00F0FF;
  font-weight: 600;
}
.list-actions {
  display: flex;
  gap: 24rpx;
}
.link {
  font-size: 26rpx;
  color: #00F0FF;
}
.link.danger {
  color: #FF6B6B;
}

.image-row {
  display: flex;
  align-items: center;
  padding: 12rpx;
  border-radius: 16rpx;
  background: rgba(255,255,255,0.03);
  margin-bottom: 12rpx;
}
.image-index {
  width: 48rpx;
  height: 48rpx;
  background: rgba(0,240,255,0.15);
  color: #00F0FF;
  border-radius: 50%;
  text-align: center;
  line-height: 48rpx;
  font-size: 24rpx;
  font-weight: 600;
  flex-shrink: 0;
}
.image-thumb {
  width: 96rpx;
  height: 96rpx;
  border-radius: 12rpx;
  margin: 0 16rpx;
  background: rgba(255,255,255,0.05);
  flex-shrink: 0;
}
.image-info {
  flex: 1;
  min-width: 0;
  overflow: hidden;
}
.image-name {
  display: block;
  font-size: 26rpx;
  color: #fff;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}
.image-actions {
  display: flex;
  gap: 8rpx;
  flex-shrink: 0;
}
.icon-btn {
  width: 56rpx;
  height: 56rpx;
  line-height: 56rpx;
  text-align: center;
  border-radius: 50%;
  background: rgba(0,240,255,0.1);
  color: #00F0FF;
  font-size: 28rpx;
}
.icon-btn.danger {
  background: rgba(255,107,107,0.12);
  color: #FF6B6B;
}

/* 上传卡片 */
.upload-card {
  background: rgba(0,240,255,0.03);
  border: 2rpx dashed rgba(0,240,255,0.35);
  border-radius: 24rpx;
  padding: 60rpx 32rpx;
  text-align: center;
  margin-bottom: 24rpx;
}
.upload-icon {
  font-size: 80rpx;
  color: #00F0FF;
  line-height: 1;
}
.upload-text {
  font-size: 30rpx;
  color: #fff;
  margin-top: 16rpx;
  font-weight: 600;
}
.upload-sub {
  font-size: 24rpx;
  color: rgba(255,255,255,0.5);
  margin-top: 8rpx;
}

/* 设置 */
.settings {
  background: rgba(255,255,255,0.03);
  border: 2rpx solid rgba(255,255,255,0.08);
  border-radius: 24rpx;
  padding: 28rpx;
  margin-bottom: 24rpx;
}
.settings-title {
  font-size: 30rpx;
  color: #fff;
  font-weight: 600;
  margin-bottom: 20rpx;
}
.setting-row {
  margin-bottom: 28rpx;
}
.row-head {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 8rpx;
}
.setting-label {
  font-size: 28rpx;
  color: rgba(255,255,255,0.75);
  display: block;
  margin-bottom: 12rpx;
}
.setting-value {
  font-size: 28rpx;
  color: #00F0FF;
  font-weight: 600;
}
.setting-hint {
  display: block;
  font-size: 22rpx;
  color: rgba(255,255,255,0.4);
  margin-top: 8rpx;
}

.page-size-options {
  display: flex;
  gap: 12rpx;
}
.page-size-item {
  flex: 1;
  padding: 20rpx 12rpx;
  background: rgba(255,255,255,0.04);
  border: 2rpx solid rgba(255,255,255,0.08);
  border-radius: 16rpx;
  text-align: center;
  transition: all 0.2s;
}
.page-size-item.active {
  background: rgba(0,240,255,0.12);
  border-color: #00F0FF;
  box-shadow: 0 0 20rpx rgba(0,240,255,0.25);
}
.ps-label {
  display: block;
  font-size: 30rpx;
  color: #fff;
  font-weight: 600;
}
.ps-desc {
  display: block;
  font-size: 20rpx;
  color: rgba(255,255,255,0.5);
  margin-top: 4rpx;
}

.text-input {
  background: rgba(255,255,255,0.05);
  border: 2rpx solid rgba(255,255,255,0.1);
  border-radius: 12rpx;
  padding: 16rpx 20rpx;
  font-size: 28rpx;
  color: #fff;
}

/* 按钮 */
.btn-primary {
  margin-top: 24rpx;
  background: linear-gradient(135deg, #00F0FF 0%, #4A90E2 100%);
  color: #0A0E27;
  font-size: 30rpx;
  font-weight: 700;
  border-radius: 16rpx;
  padding: 22rpx 0;
  letter-spacing: 2rpx;
}
.btn-secondary {
  margin-top: 16rpx;
  background: rgba(255,255,255,0.06);
  color: #fff;
  font-size: 28rpx;
  border-radius: 16rpx;
  padding: 22rpx 0;
  border: 2rpx solid rgba(255,255,255,0.12);
}

/* 结果 */
.result {
  padding-top: 40rpx;
}
.result-card {
  background: rgba(0,240,255,0.06);
  border: 2rpx solid rgba(0,240,255,0.3);
  border-radius: 24rpx;
  padding: 48rpx 24rpx;
  text-align: center;
  margin-bottom: 24rpx;
  box-shadow: 0 0 40rpx rgba(0,240,255,0.15);
}
.result-icon {
  font-size: 96rpx;
}
.result-title {
  font-size: 36rpx;
  color: #fff;
  font-weight: 700;
  margin: 16rpx 0 24rpx;
}
.result-stats {
  display: flex;
  justify-content: space-around;
  margin-top: 24rpx;
}
.stat-item {
  flex: 1;
}
.stat-label {
  display: block;
  font-size: 22rpx;
  color: rgba(255,255,255,0.5);
}
.stat-value {
  display: block;
  font-size: 30rpx;
  color: #00F0FF;
  font-weight: 700;
  margin-top: 6rpx;
}

.tip {
  margin-top: 32rpx;
  padding: 20rpx;
  background: rgba(255,255,255,0.03);
  border-radius: 12rpx;
  font-size: 24rpx;
  color: rgba(255,255,255,0.55);
  line-height: 1.6;
}
