/* pages/formatRecommend/formatRecommend.wxss */
.page-container {
  min-height: 100vh;
  padding: var(--space-lg);
  box-sizing: border-box;
  position: relative;
  z-index: 1;
}

/* 页头 */
.page-header {
  margin-bottom: var(--space-md);
}
.header-line {
  width: 64rpx;
  height: 6rpx;
  background: var(--gradient-neon);
  border-radius: 4rpx;
  margin-bottom: var(--space-sm);
  box-shadow: var(--shadow-neon);
}
.header-title {
  display: block;
  font-family: var(--font-family-display);
  font-size: 44rpx;
  font-weight: 700;
  color: var(--color-white);
  letter-spacing: 2rpx;
}
.header-sub {
  display: block;
  margin-top: 6rpx;
  font-size: 24rpx;
  color: var(--color-gray-500);
}

.hidden-canvas {
  position: fixed;
  left: -9999rpx;
  top: -9999rpx;
  width: 240rpx;
  height: 240rpx;
}

/* 卡片 */
.section {
  margin-bottom: var(--space-md);
}
.section-title {
  display: flex;
  align-items: center;
  justify-content: space-between;
  font-size: 30rpx;
  font-weight: 600;
  color: var(--color-neon-cyan);
  margin-bottom: var(--space-sm);
}
.section-count {
  font-size: 24rpx;
  color: var(--color-gray-500);
  font-weight: 400;
}

.hint {
  font-size: 22rpx;
  color: var(--color-gray-500);
  margin-top: var(--space-sm);
  line-height: 1.5;
}

/* 选图区 */
.src-preview {
  width: 100%;
  border-radius: var(--radius-md);
  overflow: hidden;
  background: repeating-conic-gradient(rgba(255,255,255,0.04) 0% 25%, transparent 0% 50%) 0 0 / 32rpx 32rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: var(--space-sm);
  min-height: 200rpx;
}
.src-img {
  width: 100%;
  max-height: 520rpx;
}
.src-meta {
  font-size: 22rpx;
  color: var(--color-gray-500);
  margin-bottom: var(--space-sm);
}
.src-actions {
  display: flex;
  gap: var(--space-sm);
}
.src-btn {
  flex: 1;
  height: 80rpx;
  line-height: 80rpx;
  font-size: 28rpx;
}
.src-btn.danger {
  color: var(--color-hot-magenta);
  border-color: rgba(255, 0, 128, 0.5);
}

/* 分析中 */
.analyzing-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
}
.loading-dot {
  width: 20rpx;
  height: 20rpx;
  border-radius: 50%;
  background: var(--color-neon-cyan);
  box-shadow: 0 0 12rpx rgba(0, 240, 255, 0.7);
  animation: fr-pulse 1s ease-in-out infinite;
}
@keyframes fr-pulse {
  0%, 100% { opacity: 0.3; transform: scale(0.8); }
  50% { opacity: 1; transform: scale(1.2); }
}
.analyzing-text {
  font-size: 26rpx;
  color: var(--color-gray-200);
}

/* 特征网格 */
.feature-grid {
  display: flex;
  flex-wrap: wrap;
  gap: var(--space-sm);
}
.feature-cell {
  width: calc((100% - 2 * var(--space-sm)) / 3);
  background: rgba(255, 255, 255, 0.03);
  border: 1rpx solid rgba(0, 240, 255, 0.12);
  border-radius: var(--radius-md);
  padding: 18rpx 14rpx;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  box-sizing: border-box;
}
.feature-label {
  font-size: 22rpx;
  color: var(--color-gray-500);
}
.feature-value {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--color-white);
}
.feature-value-sm {
  font-size: 22rpx;
  font-weight: 400;
}

/* 场景选择 */
.scenario-row {
  display: flex;
  gap: var(--space-sm);
}
.scenario-chip {
  flex: 1;
  text-align: center;
  padding: 18rpx 0;
  font-size: 26rpx;
  color: var(--color-gray-200);
  background: rgba(255, 255, 255, 0.03);
  border: 1rpx solid rgba(255, 255, 255, 0.1);
  border-radius: var(--radius-md);
}
.scenario-chip.active {
  color: var(--color-deep-space);
  background: var(--gradient-neon);
  border-color: transparent;
  font-weight: 600;
  box-shadow: var(--shadow-neon);
}

/* 推荐卡 */
.rec-card {
  background: rgba(255, 255, 255, 0.03);
  border: 1rpx solid rgba(255, 255, 255, 0.08);
  border-radius: var(--radius-md);
  padding: 22rpx;
  margin-bottom: var(--space-sm);
}
.rec-card.primary {
  border-color: rgba(0, 240, 255, 0.4);
  background: linear-gradient(135deg, rgba(0, 240, 255, 0.08) 0%, rgba(255, 0, 128, 0.05) 100%);
  box-shadow: 0 0 16rpx rgba(0, 240, 255, 0.15);
}
.rec-card.alt {
  opacity: 0.92;
}
.rec-head {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 12rpx;
}
.rec-format {
  font-size: 34rpx;
  font-weight: 700;
  color: var(--color-white);
  letter-spacing: 1rpx;
}
.rec-badge {
  font-size: 20rpx;
  padding: 4rpx 14rpx;
  border-radius: 20rpx;
  color: var(--color-gray-500);
  background: rgba(255, 255, 255, 0.06);
  border: 1rpx solid rgba(255, 255, 255, 0.12);
}
.rec-badge.primary-badge {
  color: var(--color-deep-space);
  background: var(--gradient-neon);
  border-color: transparent;
  font-weight: 600;
}
.rec-conv {
  margin-left: auto;
  font-size: 20rpx;
  padding: 4rpx 14rpx;
  border-radius: 20rpx;
}
.rec-conv.ok {
  color: var(--color-neon-cyan);
  background: rgba(0, 240, 255, 0.1);
  border: 1rpx solid rgba(0, 240, 255, 0.3);
}
.rec-conv.warn {
  color: var(--color-solar-flare);
  background: rgba(255, 107, 53, 0.1);
  border: 1rpx solid rgba(255, 107, 53, 0.3);
}
.rec-meta {
  display: flex;
  gap: 24rpx;
  margin-bottom: 12rpx;
}
.rec-quality {
  font-size: 24rpx;
  color: var(--color-gray-200);
}
.rec-size {
  font-size: 24rpx;
  color: var(--color-neon-cyan);
  font-weight: 600;
}
.rec-reason {
  font-size: 24rpx;
  color: var(--color-gray-500);
  line-height: 1.5;
}

/* 转换控件 */
.convert-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-top: var(--space-sm);
}
.convert-label {
  width: 160rpx;
  font-size: 26rpx;
  color: var(--color-gray-200);
  flex-shrink: 0;
}
.format-toggle {
  flex: 1;
  display: flex;
  gap: var(--space-sm);
}
.format-chip {
  flex: 1;
  text-align: center;
  padding: 16rpx 0;
  font-size: 26rpx;
  color: var(--color-gray-200);
  background: rgba(255, 255, 255, 0.03);
  border: 1rpx solid rgba(255, 255, 255, 0.1);
  border-radius: var(--radius-md);
}
.format-chip.active {
  color: var(--color-deep-space);
  background: var(--gradient-neon);
  border-color: transparent;
  font-weight: 600;
}
.quality-slider {
  flex: 1;
  margin: 0 12rpx;
}
.convert-est {
  font-size: 24rpx;
  color: var(--color-neon-cyan);
  margin-top: var(--space-sm);
}
.convert-actions {
  margin-top: var(--space-md);
}
.convert-btn {
  width: 100%;
  height: 84rpx;
  line-height: 84rpx;
  font-size: 28rpx;
}

/* 转换结果 */
.preview-wrap {
  width: 100%;
  border-radius: var(--radius-md);
  overflow: hidden;
  background: repeating-conic-gradient(rgba(255,255,255,0.04) 0% 25%, transparent 0% 50%) 0 0 / 32rpx 32rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: var(--space-sm);
}
.preview-img {
  width: 100%;
}
.result-meta {
  font-size: 24rpx;
  color: var(--color-gray-500);
  margin-bottom: var(--space-sm);
}
.save-btn { margin-top: 0; }
