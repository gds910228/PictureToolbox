/* pages/aiDescribe/aiDescribe.wxss
   赛博朋克主题（对齐 aiCaption，使用 app.wxss 设计令牌） */

.container {
  min-height: 100vh;
  padding: 20rpx;
}

.page-header {
  text-align: center;
  padding: 40rpx 0;
}

.page-title {
  display: block;
  font-size: 48rpx;
  font-weight: bold;
  color: var(--color-white);
  margin-bottom: 10rpx;
  text-shadow: 0 0 16rpx rgba(0, 240, 255, 0.3);
}

.page-subtitle {
  display: block;
  font-size: 28rpx;
  color: var(--color-gray-500);
}

/* 今日额度提示（顶层常驻） */
.quota-tip {
  text-align: center;
  font-size: 22rpx;
  color: var(--color-gray-500);
  margin: 4rpx 0 24rpx;
  padding: 12rpx 20rpx;
  background: rgba(0, 240, 255, 0.04);
  border: 1rpx solid rgba(0, 240, 255, 0.12);
  border-radius: var(--radius-sm);
  line-height: 1.5;
}

/* 错误态 */
.error-card {
  background: rgba(255, 0, 128, 0.08);
  border: 1rpx solid rgba(255, 0, 128, 0.35);
  border-radius: var(--radius-md);
  padding: 24rpx;
  text-align: center;
  margin-bottom: 20rpx;
}
.error-text {
  display: block;
  color: var(--color-hot-magenta);
  font-size: 28rpx;
  line-height: 1.5;
  margin-bottom: 16rpx;
}
.retry-btn {
  display: inline-block;
  height: 60rpx;
  line-height: 60rpx;
  padding: 0 40rpx;
  font-size: 26rpx;
  font-weight: 600;
  color: var(--color-hot-magenta);
  background: transparent;
  border: 2rpx solid var(--color-hot-magenta);
  border-radius: 30rpx;
}
.retry-btn::after {
  border: none;
}

.image-section {
  background: rgba(255, 255, 255, 0.05);
  border-radius: var(--radius-lg);
  padding: 20rpx;
  margin-bottom: 30rpx;
}

.preview-image {
  width: 100%;
  height: 400rpx;
  border-radius: var(--radius-md);
  background: rgba(255, 255, 255, 0.1);
}

.preview-image.placeholder {
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(0, 240, 255, 0.04);
  border: 2rpx dashed rgba(0, 240, 255, 0.3);
  position: relative;
}

.preview-image.placeholder::after {
  content: '点击上传图片';
  position: absolute;
  color: var(--color-gray-500);
  font-size: 28rpx;
}

.style-section {
  margin-bottom: 30rpx;
}

.section-title {
  font-size: 32rpx;
  color: var(--color-white);
  margin-bottom: 20rpx;
  font-weight: bold;
}

.style-list {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 12rpx;
}

.style-item {
  background: rgba(255, 255, 255, 0.05);
  border-radius: var(--radius-md);
  padding: 15rpx 10rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  border: 2rpx solid transparent;
  transition: all 0.3s;
  text-align: center;
}

.style-icon {
  font-size: 32rpx;
  margin-bottom: 6rpx;
}

.style-label {
  font-size: 24rpx;
  color: var(--color-white);
}

.style-item.active {
  background: rgba(0, 240, 255, 0.12);
  border-color: var(--color-neon-cyan);
  box-shadow: 0 0 14rpx rgba(0, 240, 255, 0.35);
}

.generate-section {
  margin-bottom: 30rpx;
}

.generate-btn {
  width: 100%;
  height: 90rpx;
  background: var(--gradient-neon);
  color: var(--color-deep-space);
  border-radius: var(--radius-lg);
  font-size: 32rpx;
  font-weight: bold;
  border: none;
  text-align: center;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: var(--shadow-neon);
}

.generate-btn[disabled] {
  background: rgba(255, 255, 255, 0.1);
  color: var(--color-gray-500);
  box-shadow: none;
}

.result-section {
  background: rgba(255, 255, 255, 0.05);
  border-radius: var(--radius-lg);
  padding: 30rpx;
}

.result-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}

/* 示例文案角标（未配置 AI 密钥时显示，复用 aiCaption 的 mock-badge 样式） */
.mock-badge {
  display: inline-block;
  font-size: 22rpx;
  color: var(--color-solar-flare);
  background: rgba(255, 107, 53, 0.12);
  border: 1rpx solid rgba(255, 107, 53, 0.4);
  border-radius: 999rpx;
  padding: 6rpx 16rpx;
  margin-bottom: 20rpx;
}

.result-title {
  font-size: 32rpx;
  color: var(--color-white);
  font-weight: bold;
}

.copy-btn {
  width: 120rpx;
  height: 60rpx;
  line-height: 60rpx;
  background: rgba(0, 240, 255, 0.1);
  color: var(--color-neon-cyan);
  border: 1rpx solid rgba(0, 240, 255, 0.4);
  border-radius: 999rpx;
  font-size: 24rpx;
  text-align: center;
  display: flex;
  align-items: center;
  justify-content: center;
}

.copy-btn::after {
  border: none;
}

.result-content {
  background: rgba(0, 0, 0, 0.2);
  border-radius: var(--radius-md);
  padding: 20rpx;
}

.description-text {
  font-size: 28rpx;
  color: var(--color-white);
  line-height: 1.8;
}
