/* pkgGreeting/pages/greeting/greeting.wxss
   今日问候 · 浅色大字长辈友好皮肤。
   页面级覆盖：不用全局 design token（赛博朋克），仅本页生效，不影响其他页面。 */

/* 浅色底 + 深字 + 大字号基础（app.wxss 的暗色网格背景在本页关闭）
   底色用奶油/宣纸色而非纯白：暖意更足，避免"像系统默认页"的苍白感 */
page {
  background: #FAEDDB;
  color: #4A3520;
  font-size: 34rpx;
}

page::before {
  display: none;
}

/* 顶部氛围带：随节日/节气变色（full-bleed 圆角收底，日期一眼可见） */
.g-band {
  margin: -32rpx -32rpx 20rpx;
  padding: 44rpx 40rpx 40rpx;
  border-radius: 0 0 44rpx 44rpx;
  color: #FFFFFF;
}

.g-band-date {
  font-size: 32rpx;
  font-weight: bold;
  letter-spacing: 2rpx;
}

.g-band--festival {
  background: linear-gradient(135deg, #D9503A, #F0A93C);
}

.g-band--term {
  background: linear-gradient(135deg, #3E8E6B, #8FBF7A);
}

.g-band--plain {
  background: linear-gradient(135deg, #F08A3C, #F5BE4F);
}

.g-page {
  padding: 32rpx 32rpx 64rpx;
}

/* ---------- 标题 ---------- */

.g-h1 {
  font-size: 44rpx;
  font-weight: bold;
  color: #4A3520;
  margin: 24rpx 0 12rpx;
}

.g-h1-row {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
}

.g-h1-tip {
  font-size: 26rpx;
  font-weight: normal;
  color: #B08A5C;
}

.g-h2 {
  font-size: 30rpx;
  color: #8A6A45;
  margin-bottom: 24rpx;
}

.g-occasion {
  font-size: 28rpx;
  color: #B0631F;
  background: #FFFFFF;
  border: 2rpx solid #E8C89A;
  border-radius: 16rpx;
  padding: 12rpx 20rpx;
  margin: 16rpx 0;
}

/* ---------- 步骤 1：照片 ---------- */

.g-photo-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 20rpx;
  margin: 24rpx 0 36rpx;
}

.g-photo-item {
  position: relative;
  width: 200rpx;
  height: 200rpx;
  border-radius: 20rpx;
  overflow: hidden;
}

.g-photo-img {
  width: 100%;
  height: 100%;
}

.g-photo-del {
  position: absolute;
  top: 0;
  right: 0;
  width: 56rpx;
  height: 56rpx;
  background: rgba(0, 0, 0, 0.45);
  color: #FFFFFF;
  font-size: 40rpx;
  line-height: 52rpx;
  text-align: center;
  border-radius: 0 0 0 20rpx;
}

.g-photo-add {
  width: 200rpx;
  height: 200rpx;
  border: 3rpx dashed #D8B78A;
  border-radius: 20rpx;
  background: #FFF4E2;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  color: #B08A5C;
}

.g-photo-add-icon {
  font-size: 64rpx;
  line-height: 1;
}

.g-photo-add-text {
  font-size: 26rpx;
  margin-top: 8rpx;
}

/* ---------- 步骤 2：样式与祝福 ---------- */

.g-tpl-row {
  display: flex;
  gap: 18rpx;
  margin: 20rpx 0 8rpx;
}

.g-tpl {
  flex: 1;
  height: 96rpx;
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 30rpx;
  font-weight: bold;
  border: 4rpx solid transparent;
  opacity: 0.75;
}

.g-tpl.is-on {
  border-color: #B0631F;
  opacity: 1;
}

.g-slot-row {
  display: flex;
  gap: 18rpx;
  margin: 16rpx 0;
}

.g-slot {
  padding: 16rpx 40rpx;
  border-radius: 999rpx;
  background: #FFF1DC;
  color: #8A6A45;
  font-size: 32rpx;
  border: 4rpx solid transparent;
}

.g-slot.is-on {
  background: #FFDFA8;
  border-color: #B0631F;
  color: #6B3E0E;
  font-weight: bold;
}

.g-pool {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  margin: 16rpx 0 24rpx;
}

.g-pool-item {
  padding: 22rpx 26rpx;
  border-radius: 20rpx;
  background: #FFFFFF;
  border: 3rpx solid #F0DFC8;
  font-size: 32rpx;
  color: #4A3520;
}

.g-pool-item.is-on {
  border-color: #E08A2E;
  background: #FFF6E6;
  color: #6B3E0E;
  font-weight: bold;
}

/* AI 候选 */

.g-btn-ai {
  margin-top: 8rpx;
}

.g-btn-shuffle {
  height: 88rpx;
  background: #FFFFFF;
  color: #B0631F;
  border: 3rpx dashed #E8C89A;
  font-weight: normal;
  font-size: 32rpx;
}

.g-ai-list {
  display: flex;
  flex-direction: column;
  gap: 14rpx;
  margin: 18rpx 0;
}

.g-ai-item {
  padding: 20rpx 26rpx;
  border-radius: 20rpx;
  background: #F3F8FF;
  border: 3rpx solid #CCE0F5;
  font-size: 32rpx;
  color: #274B6E;
}

.g-ai-item.is-on {
  border-color: #3E7CB8;
  background: #E7F1FC;
  font-weight: bold;
}

.g-ai-mock {
  font-size: 24rpx;
  color: #B08A5C;
}

.g-textarea {
  width: 100%;
  box-sizing: border-box;
  min-height: 160rpx;
  background: #FFFFFF;
  border: 3rpx solid #F0DFC8;
  border-radius: 20rpx;
  padding: 22rpx 26rpx;
  font-size: 34rpx;
  color: #4A3520;
  margin: 8rpx 0 28rpx;
}

/* ---------- 步骤 3：成品 ---------- */

.g-preview {
  width: 100%;
  border-radius: 24rpx;
  margin: 8rpx 0 32rpx;
  box-shadow: 0 8rpx 32rpx rgba(122, 74, 16, 0.14);
}

/* ---------- 按钮（全局 button 规则已强制 flex 居中，这里只管配色与尺寸） ---------- */

.g-btn {
  height: 100rpx;
  border-radius: 24rpx;
  font-size: 36rpx;
  font-weight: bold;
  margin: 20rpx 0 0;
}

.g-btn::after {
  border: none;
}

.g-btn-primary {
  background: linear-gradient(135deg, #FFB13C, #F0821E);
  color: #FFFFFF;
  box-shadow: 0 8rpx 24rpx rgba(240, 130, 30, 0.30);
}

.g-btn-next {
  background: linear-gradient(135deg, #FFB13C, #F0821E);
  color: #FFFFFF;
}

.g-btn-next[disabled] {
  background: #F0DFC8;
  color: #B9A488;
}

.g-btn-secondary {
  background: #FFFFFF;
  color: #B0631F;
  border: 3rpx solid #E8C89A;
}

.g-btn-ai {
  background: #E7F1FC;
  color: #2E6396;
  border: 3rpx solid #CCE0F5;
  font-weight: normal;
}

.g-btn-ai[disabled] {
  background: #EFF4FA;
  color: #93AEC7;
}

.g-btn-ghost {
  background: transparent;
  color: #B08A5C;
  font-weight: normal;
}

/* ---------- 离屏画布 ---------- */

.g-canvas {
  position: fixed;
  left: -9999rpx;
  top: 0;
  width: 540px;
  height: 720px;
}
