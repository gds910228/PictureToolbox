<!--pages/crop/crop.wxml-->
<view class="container">
  <!-- 步骤 1：选图 -->
  <view wx:if="{{!imageSrc}}" class="upload-section">
    <view class="upload-box" bindtap="chooseImage">
      <text class="upload-icon">✂️</text>
      <text class="upload-text">点击选择图片</text>
      <text class="upload-sub">智能构图 · 多比例 / 平台尺寸交互裁剪</text>
    </view>
    <view class="upload-tip">本地算法即时定位主体，拖拽缩放微调，实时预览</view>
  </view>

  <!-- 步骤 2：交互式裁剪 -->
  <view wx:if="{{imageSrc && !showResult}}" class="editor">
    <view class="stage-wrap">
      <view class="stage" style="width:{{stageW}}px;height:{{stageH}}px;">
        <image class="stage-img" src="{{imageSrc}}" mode="scaleToFill"
               style="width:{{stageW}}px;height:{{stageH}}px;" />
        <view class="crop-box"
              style="left:{{box.x}}px;top:{{box.y}}px;width:{{box.w}}px;height:{{box.h}}px;"
              catchtouchstart="onBoxTouchStart"
              catchtouchmove="onBoxTouchMove"
              catchtouchend="onBoxTouchEnd">
          <view class="handle h-tl"></view>
          <view class="handle h-tr"></view>
          <view class="handle h-bl"></view>
          <view class="handle h-br"></view>
        </view>
      </view>
    </view>

    <view class="detect-label" wx:if="{{detectSource === 'local'}}">
      <text class="dot"></text>
      <text>本地智能构图</text>
    </view>

    <view class="preset-section">
      <view class="section-title">比例</view>
      <view class="preset-row">
        <view wx:for="{{ratioPresets}}" wx:key="id"
              class="preset-chip {{presetId === item.id ? 'active' : ''}}"
              data-id="{{item.id}}" bindtap="selectRatio">
          <text class="chip-name">{{item.name}}</text>
          <text class="chip-desc">{{item.desc}}</text>
        </view>
      </view>

      <view class="section-title">平台尺寸</view>
      <view class="preset-row">
        <view wx:for="{{platformPresets}}" wx:key="id"
              class="preset-chip {{presetId === item.id ? 'active' : ''}}"
              data-id="{{item.id}}" bindtap="selectPlatform">
          <text class="chip-name">{{item.name}}</text>
          <text class="chip-desc">{{item.desc}}</text>
        </view>
      </view>
    </view>

    <view class="slider-section">
      <view class="section-title">缩放微调</view>
      <slider class="zoom-slider" min="30" max="100" value="{{sliderVal}}"
              block-size="22" activeColor="#00f0ff" backgroundColor="rgba(255,255,255,0.1)"
              bindchanging="onSlider" bindchange="onSlider" />
    </view>

    <view class="preview-section">
      <view class="section-title">实时预览</view>
      <view class="preview-pane" style="width:{{previewW}}px;height:{{previewH}}px;">
        <image class="preview-img" src="{{imageSrc}}" mode="scaleToFill"
               style="width:{{pvImgW}}px;height:{{pvImgH}}px;transform:translate({{pvX}}px,{{pvY}}px);" />
      </view>
    </view>

    <view class="actions">
      <button class="btn-primary" bindtap="onConfirm" loading="{{processing}}" disabled="{{processing}}">
        {{processing ? '裁剪中...' : '完成裁剪'}}
      </button>
      <button class="btn-secondary" bindtap="resetAll">重新选图</button>
    </view>
  </view>

  <!-- 步骤 3：结果 -->
  <view wx:if="{{showResult}}" class="result-section">
    <view class="result-title">裁剪完成</view>
    <image class="result-img" src="{{resultSrc}}" mode="aspectFit" bindtap="previewResult" />
    <view class="result-info">{{resultInfo}}</view>
    <button class="btn-primary" bindtap="saveResult">保存到相册</button>
    <button class="btn-secondary" bindtap="resetAll">再裁一张</button>
  </view>
</view>
