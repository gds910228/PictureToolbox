/* pages/aiDescribe/aiDescribe.wxss */
.container {
  min-height: 100vh;
  background: linear-gradient(135deg, #0A0E27 0%, #1a1f3a 100%);
  padding: 20rpx;
}

.page-header {
  text-align: center;
  padding: 40rpx 0;
}

.page-title {
  display: block;
  font-size: 48rpx;
  font-weight: bold;
  color: #ffffff;
  margin-bottom: 10rpx;
}

.page-subtitle {
  display: block;
  font-size: 28rpx;
  color: #8b9dc3;
}

.image-section {
  background: rgba(255, 255, 255, 0.05);
  border-radius: 20rpx;
  padding: 20rpx;
  margin-bottom: 30rpx;
}

.preview-image {
  width: 100%;
  height: 400rpx;
  border-radius: 12rpx;
  background: rgba(255, 255, 255, 0.1);
}

.preview-image.placeholder {
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(255, 255, 255, 0.05);
  position: relative;
}

.preview-image.placeholder::after {
  content: '点击上传图片';
  position: absolute;
  color: #8b9dc3;
  font-size: 28rpx;
}

.image-actions {
  display: flex;
  justify-content: space-around;
  margin-top: 20rpx;
}

.action-btn {
  width: 45%;
  height: 70rpx;
  line-height: 70rpx;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  color: #ffffff;
  border-radius: 35rpx;
  font-size: 28rpx;
  border: none;
}

.upload-tip {
  height: 400rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.tip-text {
  font-size: 28rpx;
  color: #8b9dc3;
}

.style-section {
  margin-bottom: 30rpx;
}

.section-title {
  font-size: 32rpx;
  color: #ffffff;
  margin-bottom: 20rpx;
  font-weight: bold;
}

.style-list {
  display: flex;
  flex-wrap: wrap;
  gap: 15rpx;
}

.style-item {
  flex: 1;
  min-width: 45%;
  background: rgba(255, 255, 255, 0.05);
  border-radius: 12rpx;
  padding: 20rpx;
  display: flex;
  align-items: center;
  border: 2rpx solid transparent;
  transition: all 0.3s;
}

.style-item.active {
  background: rgba(102, 126, 234, 0.2);
  border-color: #667eea;
}

.style-icon {
  font-size: 36rpx;
  margin-right: 10rpx;
}

.style-label {
  font-size: 28rpx;
  color: #ffffff;
}

.generate-section {
  margin-bottom: 30rpx;
}

.generate-btn {
  width: 100%;
  height: 90rpx;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  color: #ffffff;
  border-radius: 45rpx;
  font-size: 32rpx;
  font-weight: bold;
  border: none;
}

.generate-btn[disabled] {
  background: rgba(255, 255, 255, 0.1);
  color: #8b9dc3;
}

.result-section {
  background: rgba(255, 255, 255, 0.05);
  border-radius: 20rpx;
  padding: 30rpx;
}

.result-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}

.result-title {
  font-size: 32rpx;
  color: #ffffff;
  font-weight: bold;
}

.copy-btn {
  width: 120rpx;
  height: 60rpx;
  line-height: 60rpx;
  background: rgba(102, 126, 234, 0.3);
  color: #667eea;
  border-radius: 30rpx;
  font-size: 24rpx;
  border: none;
}

.result-content {
  background: rgba(0, 0, 0, 0.2);
  border-radius: 12rpx;
  padding: 20rpx;
}

.description-text {
  font-size: 28rpx;
  color: #ffffff;
  line-height: 1.8;
}
