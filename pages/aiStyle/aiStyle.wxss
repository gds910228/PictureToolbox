.container {
  min-height: 100vh;
  background: linear-gradient(135deg, #0A0E27 0%, #1a1f3a 100%);
  padding: 20rpx;
  padding-bottom: 40rpx;
}

.page-header {
  text-align: center;
  padding: 20rpx 0 30rpx;
}

.page-title {
  display: block;
  font-size: 48rpx;
  font-weight: bold;
  color: #fff;
  margin-bottom: 10rpx;
}

.page-subtitle {
  display: block;
  font-size: 28rpx;
  color: #8b9dc3;
}

/* 图片对比区域 */
.compare-section {
  display: flex;
  gap: 20rpx;
  margin-bottom: 20rpx;
}

.compare-item {
  flex: 1;
  background: rgba(255,255,255,0.05);
  border-radius: 20rpx;
  padding: 20rpx;
  border: 2rpx solid rgba(255,255,255,0.1);
}

.compare-title {
  font-size: 28rpx;
  color: #fff;
  margin-bottom: 15rpx;
  text-align: center;
  font-weight: bold;
}

.compare-box {
  width: 100%;
  height: 350rpx;
  background: rgba(0,0,0,0.2);
  border-radius: 12rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  position: relative;
  overflow: hidden;
}

.compare-box::after {
  content: '🔍';
  position: absolute;
  bottom: 10rpx;
  right: 10rpx;
  font-size: 32rpx;
  opacity: 0;
  transition: opacity 0.3s;
  z-index: 10;
}

.compare-box:hover::after {
  opacity: 0.7;
}

.compare-image {
  width: 100%;
  height: 100%;
  border-radius: 12rpx;
  transition: transform 0.3s;
}

.compare-image:active {
  transform: scale(0.95);
}

.compare-image.placeholder {
  opacity: 0.3;
}

.preview-tip {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  background: rgba(0,0,0,0.6);
  color: #fff;
  font-size: 22rpx;
  text-align: center;
  padding: 8rpx 0;
  border-radius: 0 0 12rpx 12rpx;
  pointer-events: none;
}

.compare-tip {
  position: absolute;
  color: #8b9dc3;
  font-size: 24rpx;
  text-align: center;
}

/* 控制栏 */
.control-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: rgba(102,126,234,0.1);
  border-radius: 20rpx;
  padding: 20rpx;
  margin-bottom: 30rpx;
  border: 2rpx solid rgba(102,126,234,0.3);
}

.selected-style-text {
  font-size: 28rpx;
  color: #fff;
  flex: 1;
}

.generate-btn-small {
  width: 200rpx;
  height: 70rpx;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  color: #fff;
  border-radius: 35rpx;
  font-size: 28rpx;
  font-weight: bold;
  border: none;
  line-height: 70rpx;
  padding: 0;
}

.generate-btn-small[disabled] {
  background: rgba(255,255,255,0.1);
  color: #8b9dc3;
}

/* 风格选择区域 */
.style-section {
  margin-bottom: 20rpx;
}

.section-title {
  font-size: 32rpx;
  color: #fff;
  margin-bottom: 20rpx;
  font-weight: bold;
}

.style-list {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.style-item {
  width: 22%;
  background: rgba(255,255,255,0.05);
  border-radius: 12rpx;
  padding: 15rpx 10rpx;
  text-align: center;
  border: 2rpx solid transparent;
  transition: all 0.3s;
}

.style-item.active {
  background: rgba(102,126,234,0.2);
  border-color: #667eea;
  transform: scale(1.05);
}

.style-icon {
  display: block;
  font-size: 36rpx;
  margin-bottom: 8rpx;
}

.style-label {
  font-size: 24rpx;
  color: #fff;
  display: block;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

/* 保存按钮 */
.save-btn-small {
  width: 100%;
  height: 60rpx;
  background: linear-gradient(135deg, #11998e 0%, #38ef7d 100%);
  color: #fff;
  border-radius: 30rpx;
  font-size: 26rpx;
  font-weight: bold;
  border: none;
  margin-top: 15rpx;
  line-height: 60rpx;
  padding: 0;
}

/* 对比按钮（霓虹蓝描边） */
.save-btn-small.compare-btn-small {
  background: transparent;
  color: var(--color-neon-cyan);
  border: 2rpx solid var(--color-neon-cyan);
  box-shadow: 0 0 12rpx rgba(0, 240, 255, 0.3);
  text-shadow: 0 0 8rpx rgba(0, 240, 255, 0.5);
}

/* 结果操作按钮组 */
.result-actions {
  display: flex;
  gap: 20rpx;
  margin-top: 20rpx;
}

.result-actions .save-btn-small {
  flex: 1;
}
