<view class="container">
  <view class="page-header">
    <text class="page-title">AI风格迁移</text>
    <text class="page-subtitle">一键转换艺术风格</text>
  </view>

  <!-- 今日额度（顶层常驻，任何状态都可见） -->
  <view class="quota-tip" wx:if="{{usedText}}">{{usedText}} · 每日 {{limit}} 次，次日 0 点重置</view>

  <!-- ================================
       上传阶段：图片选择（无结果时显示）
       ================================ -->
  <image-uploader
    wx:if="{{!resultSrc}}"
    id="mainUploader"
    maxCount="1"
    sizeType="{{['original']}}"
    sourceType="{{['album', 'camera']}}"
    showCompressTip="{{false}}"
    tipText="点击上传图片"
    theme="purple"
    bind:change="onImageChange"
  />

  <!-- ================================
       结果阶段：左右对比（仅在有结果时显示）
       替换上传区位置，不与上传区并存
       ================================ -->
  <view class="compare-section" wx:if="{{resultSrc && imageSrc}}">
    <!-- 原图 -->
    <view class="compare-item">
      <view class="compare-title">原图</view>
      <view class="compare-box" bindtap="previewOriginalImage">
        <image class="compare-image" src="{{imageSrc}}" mode="aspectFit" />
        <view class="preview-tip">点击查看大图</view>
      </view>
    </view>

    <!-- 结果图 -->
    <view class="compare-item">
      <view class="compare-title">转换结果</view>
      <view class="compare-box" bindtap="previewResultImage">
        <image
          class="compare-image"
          src="{{resultSrc}}"
          mode="aspectFit"
          bindload="onImageLoad"
          binderror="onImageError"
          lazy-load="true"
        />
        <view class="preview-tip">点击查看大图</view>
      </view>
    </view>
  </view>

  <!-- 单结果图展示（无原图时，结果图占满宽度） -->
  <view class="single-result" wx:elif="{{resultSrc}}">
    <view class="single-result-title">转换结果</view>
    <view class="single-result-box" bindtap="previewResultImage">
      <image
        class="single-result-image"
        src="{{resultSrc}}"
        mode="aspectFit"
        bindload="onImageLoad"
        binderror="onImageError"
        lazy-load="true"
      />
      <view class="preview-tip">点击查看大图</view>
    </view>
  </view>

  <!-- ================================
       结果操作按钮（替换上传区位置）
       ================================ -->
  <view class="result-actions" wx:if="{{resultSrc}}">
    <button class="action-btn primary" bindtap="saveResult">保存图片</button>
    <button class="action-btn secondary" bindtap="onCompare">对比查看</button>
    <button class="action-btn secondary" bindtap="resetAndReselect">重新选择</button>
  </view>

  <!-- ================================
       转换控制栏（有图无结果时显示）
       ================================ -->
  <view class="control-bar" wx:if="{{imageSrc && !resultSrc}}">
    <text class="selected-style-text">{{selectedStyleLabel}}</text>
    <button
      class="generate-btn-small"
      bindtap="transferStyle"
      disabled="{{loading || !fileID}}"
    >
      {{loading ? '转换中...' : '开始转换'}}
    </button>
  </view>

  <!-- ================================
       风格选择区域（始终显示）
       ================================ -->
  <view class="style-section">
    <view class="section-title">选择风格</view>
    <view class="style-list">
      <view
        class="style-item {{selectedStyle === item.value ? 'active' : ''}}"
        wx:for="{{styles}}"
        wx:key="value"
        data-style="{{item.value}}"
        bindtap="selectStyle"
      >
        <text class="style-icon">{{item.icon}}</text>
        <text class="style-label">{{item.label}}</text>
      </view>
    </view>
  </view>
</view>
