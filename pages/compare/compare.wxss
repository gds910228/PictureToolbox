/* ===================================
   CYBERPUNK COMPARE PAGE
   =================================== */

.cmp-page {
  display: flex;
  flex-direction: column;
  height: 100vh;
  box-sizing: border-box;
  padding: var(--space-md) var(--space-lg) var(--space-lg);
  position: relative;
  z-index: 1;
}

/* ===================================
   HEADER
   =================================== */

.cmp-header {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: var(--space-md);
}

.cmp-title {
  font-size: 30rpx;
  font-weight: 700;
  letter-spacing: 2rpx;
  color: var(--color-white);
  text-shadow: 0 0 12rpx rgba(0, 240, 255, 0.5);
  margin-bottom: var(--space-sm);
}

/* 分段控件 */
.mode-switch {
  display: flex;
  background: rgba(255, 255, 255, 0.05);
  border: 1rpx solid rgba(0, 240, 255, 0.2);
  border-radius: 999rpx;
  padding: 6rpx;
}

.mode-item {
  display: flex;
  align-items: center;
  padding: 12rpx 32rpx;
  border-radius: 999rpx;
  font-size: 26rpx;
  color: var(--color-gray-500);
  transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
}

.mode-item .mode-icon {
  margin-right: 8rpx;
}

.mode-item.active {
  color: var(--color-deep-space);
  background: var(--color-neon-cyan);
  box-shadow: 0 0 16rpx rgba(0, 240, 255, 0.6);
  font-weight: 600;
}

/* 信息栏 */
.cmp-info {
  display: flex;
  justify-content: space-between;
  font-size: 24rpx;
  color: var(--color-gray-500);
  margin-bottom: var(--space-sm);
}

/* ===================================
   STAGE（对比区）
   =================================== */

.cmp-stage {
  position: relative;
  flex: 1;
  min-height: 0;
  background: #0A0E27;
  border: 1rpx solid rgba(0, 240, 255, 0.15);
  border-radius: var(--radius-lg);
  overflow: hidden;
  box-shadow: var(--shadow-card);
}

.cmp-canvas {
  width: 100%;
  height: 100%;
  display: block;
}

/* 加载 / 失败 */
.cmp-loading,
.cmp-error {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  z-index: 5;
}

.cmp-spinner {
  width: 64rpx;
  height: 64rpx;
  border: 4rpx solid rgba(0, 240, 255, 0.2);
  border-top-color: var(--color-neon-cyan);
  border-radius: 50%;
  animation: cmp-spin 0.8s linear infinite;
}

@keyframes cmp-spin {
  to { transform: rotate(360deg); }
}

.cmp-loading-text,
.cmp-error-text {
  margin-top: var(--space-md);
  color: var(--color-gray-500);
  font-size: 26rpx;
}

.cmp-error-icon {
  font-size: 72rpx;
}

/* ===================================
   切换模式
   =================================== */

.cmp-toggle {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
}

.cmp-toggle-img {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  transition: opacity 0.35s ease;
}

.cmp-toggle-img.is-visible {
  opacity: 1;
}

.cmp-toggle-img.is-hidden {
  opacity: 0;
}

.cmp-toggle-hint {
  position: absolute;
  bottom: 28rpx;
  left: 50%;
  transform: translateX(-50%);
  background: rgba(0, 0, 0, 0.6);
  color: var(--color-neon-cyan);
  font-size: 24rpx;
  padding: 10rpx 28rpx;
  border-radius: 999rpx;
  border: 1rpx solid rgba(0, 240, 255, 0.4);
  white-space: nowrap;
}

/* ===================================
   底部标注（滑动模式）
   =================================== */

.cmp-labels {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 24rpx;
  display: flex;
  justify-content: space-between;
  padding: 0 var(--space-md);
  pointer-events: none;
  z-index: 4;
}

.cmp-label {
  font-size: 24rpx;
  color: var(--color-white);
  background: rgba(0, 0, 0, 0.55);
  padding: 6rpx 22rpx;
  border-radius: 999rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.2);
}

.cmp-label.left {
  color: var(--color-neon-cyan);
  border-color: rgba(0, 240, 255, 0.5);
  text-shadow: 0 0 8rpx rgba(0, 240, 255, 0.5);
}

.cmp-label.right {
  color: var(--color-hot-magenta);
  border-color: rgba(255, 0, 128, 0.5);
  text-shadow: 0 0 8rpx rgba(255, 0, 128, 0.5);
}

/* 缩放复位 */
.cmp-reset {
  position: absolute;
  top: 24rpx;
  right: 24rpx;
  font-size: 22rpx;
  color: var(--color-neon-cyan);
  background: rgba(0, 0, 0, 0.6);
  padding: 10rpx 24rpx;
  border-radius: 999rpx;
  border: 1rpx solid rgba(0, 240, 255, 0.4);
  z-index: 6;
}
