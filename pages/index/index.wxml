<!--pages/index/index.wxml-->
<view class="container">
  <!-- 顶部 Banner：渐变背景 + 工具名打字机 -->
  <view class="banner">
    <view class="banner-bg"></view>
    <view class="banner-glow banner-glow--cyan"></view>
    <view class="banner-glow banner-glow--magenta"></view>
    <view class="banner-content">
      <view class="banner-tag">PICTURE · TOOLBOX</view>
      <view class="banner-title">
        <text class="banner-title-static">让图片处理</text>
        <text class="banner-title-typed">{{typedName}}</text>
        <text class="banner-cursor">|</text>
      </view>
      <view class="banner-sub">智能高效 · 安全隐私 · 一键搞定</view>
      <view class="banner-dots">
        <view
          class="banner-dot {{currentToolIdx === index ? 'is-active' : ''}}"
          wx:for="{{bannerTools}}"
          wx:key="id"
        ></view>
      </view>
    </view>
  </view>

  <!-- 热门场景：高频搜索词直达，提升新用户首屏转化 -->
  <view class="hot-scenes">
    <view class="hot-scenes-title">🔥 热门场景</view>
    <view class="hot-scenes-grid">
      <navigator
        class="hot-scene-card"
        wx:for="{{hotScenes}}"
        wx:key="id"
        url="{{item.url}}"
        data-url="{{item.url}}"
        hover-class="none"
        bindtap="onSceneTap"
      >
        <view class="hot-scene-icon">{{item.icon}}</view>
        <view class="hot-scene-name">{{item.name}}</view>
      </navigator>
    </view>
  </view>

  <!-- 工具分组（折叠面板） -->
  <view class="groups">
    <view
      class="group"
      wx:for="{{groups}}"
      wx:key="key"
      wx:for-item="group"
    >
      <view
        class="group-header glass-card"
        data-key="{{group.key}}"
        bindtap="onToggleGroup"
      >
        <view class="group-header-left">
          <view class="group-icon group-icon--{{group.key}}"></view>
          <view class="group-meta">
            <view class="group-title">{{group.title}}</view>
            <view class="group-sub">{{group.subtitle}} · {{group.tools.length}} 个工具</view>
          </view>
        </view>
        <view class="group-chevron {{group.expanded ? 'is-expanded' : ''}}"></view>
      </view>

      <view class="group-body {{group.expanded ? 'is-expanded' : ''}}">
        <view class="tools-grid">
          <navigator
            class="tool-card glass-card {{item.available ? '' : 'disabled'}} {{item.isNew ? 'new-feature' : ''}}"
            wx:for="{{group.tools}}"
            wx:key="id"
            wx:for-item="item"
            url="{{item.available ? item.url : ''}}"
            hover-class="none"
            data-id="{{item.id}}"
            data-name="{{item.name}}"
            data-url="{{item.url}}"
            data-available="{{item.available}}"
            bindtap="onToolTap"
          >
            <view class="new-badge" wx:if="{{item.isNew}}">NEW</view>
            <view class="tool-icon icon-{{item.id}}"></view>
            <view class="tool-name">{{item.name}}</view>
            <view class="tool-desc">{{item.desc}}</view>
            <view class="tool-status" wx:if="{{item.available === false}}">敬请期待</view>
          </navigator>
        </view>
      </view>
    </view>
  </view>

  <!-- 特性说明 -->
  <view class="features">
    <view class="feature-item">
      <view class="feature-icon">∞</view>
      <text class="feature-text">完全免费使用</text>
    </view>
    <view class="feature-item">
      <view class="feature-icon">🔒</view>
      <text class="feature-text">本地处理保护隐私</text>
    </view>
    <view class="feature-item">
      <view class="feature-icon">⚡</view>
      <text class="feature-text">处理速度快</text>
    </view>
  </view>

  <!-- 底部信息 -->
  <view class="footer">
    <text class="footer-text">让图片处理更简单 · 未来已来</text>
  </view>
</view>