/* ===================================
   CYBERPUNK HOMEPAGE
   =================================== */

.container {
  min-height: 100vh;
  background: transparent;
  padding: 0;
  position: relative;
  overflow: hidden;
}

/* 装饰性背景元素 */
.container::before {
  content: '';
  position: absolute;
  top: -200rpx;
  right: -200rpx;
  width: 600rpx;
  height: 600rpx;
  background: radial-gradient(circle, rgba(0, 240, 255, 0.15) 0%, transparent 70%);
  border-radius: 50%;
  filter: blur(60rpx);
  z-index: 0;
}

.container::after {
  content: '';
  position: absolute;
  bottom: -300rpx;
  left: -200rpx;
  width: 700rpx;
  height: 700rpx;
  background: radial-gradient(circle, rgba(255, 0, 128, 0.1) 0%, transparent 70%);
  border-radius: 50%;
  filter: blur(80rpx);
  z-index: 0;
}

/* ===================================
   GLASS CARD - 玻璃拟态基础类
   =================================== */

.glass-card {
  background: rgba(255, 255, 255, 0.08);
  backdrop-filter: blur(20rpx);
  -webkit-backdrop-filter: blur(20rpx);
  border: 1rpx solid rgba(255, 255, 255, 0.18);
  box-shadow:
    0 8rpx 32rpx rgba(0, 0, 0, 0.25),
    inset 0 1rpx 0 rgba(255, 255, 255, 0.1);
  border-radius: var(--radius-lg);
}

/* ===================================
   BANNER - 顶部渐变 + 打字机
   =================================== */

.banner {
  position: relative;
  margin: 0 24rpx 40rpx;
  border-radius: var(--radius-xl);
  overflow: hidden;
  padding: 60rpx 40rpx 56rpx;
  z-index: 1;
  isolation: isolate;
  background: linear-gradient(135deg, #0A0E27 0%, #1A1F3A 100%);
  box-shadow: 0 16rpx 48rpx rgba(0, 0, 0, 0.4);
  border: 1rpx solid rgba(0, 240, 255, 0.15);
}

/* 渐变光带 */
.banner-bg {
  position: absolute;
  inset: 0;
  background:
    linear-gradient(135deg, rgba(0, 240, 255, 0.25) 0%, transparent 50%, rgba(255, 0, 128, 0.25) 100%);
  z-index: -2;
  animation: bannerShift 8s ease-in-out infinite alternate;
}

@keyframes bannerShift {
  0%   { filter: hue-rotate(0deg); opacity: 0.85; }
  100% { filter: hue-rotate(20deg); opacity: 1; }
}

/* 装饰光晕 */
.banner-glow {
  position: absolute;
  border-radius: 50%;
  filter: blur(40rpx);
  z-index: -1;
  pointer-events: none;
}

.banner-glow--cyan {
  width: 280rpx;
  height: 280rpx;
  top: -80rpx;
  left: -60rpx;
  background: radial-gradient(circle, rgba(0, 240, 255, 0.55) 0%, transparent 70%);
  animation: floatA 6s ease-in-out infinite;
}

.banner-glow--magenta {
  width: 320rpx;
  height: 320rpx;
  bottom: -120rpx;
  right: -80rpx;
  background: radial-gradient(circle, rgba(255, 0, 128, 0.45) 0%, transparent 70%);
  animation: floatB 7s ease-in-out infinite;
}

@keyframes floatA {
  0%, 100% { transform: translate(0, 0) scale(1); }
  50%      { transform: translate(20rpx, 16rpx) scale(1.08); }
}

@keyframes floatB {
  0%, 100% { transform: translate(0, 0) scale(1); }
  50%      { transform: translate(-24rpx, -20rpx) scale(1.1); }
}

.banner-content {
  position: relative;
  z-index: 1;
  text-align: left;
}

.banner-tag {
  display: inline-block;
  font-size: 22rpx;
  letter-spacing: 4rpx;
  color: var(--color-neon-cyan);
  background: rgba(0, 240, 255, 0.12);
  border: 1rpx solid rgba(0, 240, 255, 0.35);
  padding: 6rpx 18rpx;
  border-radius: 999rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 0 12rpx rgba(0, 240, 255, 0.25);
  animation: tagPulse 3s ease-in-out infinite;
}

@keyframes tagPulse {
  0%, 100% { box-shadow: 0 0 12rpx rgba(0, 240, 255, 0.25); }
  50%      { box-shadow: 0 0 20rpx rgba(0, 240, 255, 0.45); }
}

.banner-title {
  display: flex;
  align-items: baseline;
  flex-wrap: wrap;
  font-size: 56rpx;
  font-weight: 900;
  line-height: 1.25;
  color: var(--color-white);
  letter-spacing: 2rpx;
  text-shadow: 0 0 20rpx rgba(0, 240, 255, 0.35);
  margin-bottom: 16rpx;
}

.banner-title-static {
  margin-right: 12rpx;
}

.banner-title-typed {
  background: var(--gradient-neon);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  background-clip: text;
  color: transparent;
  min-width: 4rpx;
}

.banner-cursor {
  display: inline-block;
  margin-left: 4rpx;
  font-weight: 400;
  color: var(--color-neon-cyan);
  -webkit-text-fill-color: var(--color-neon-cyan);
  animation: cursorBlinkBanner 1s steps(2, end) infinite;
}

@keyframes cursorBlinkBanner {
  0%, 50%   { opacity: 1; }
  51%, 100% { opacity: 0; }
}

.banner-sub {
  font-size: 24rpx;
  color: var(--color-gray-200);
  letter-spacing: 2rpx;
  opacity: 0.85;
  margin-bottom: 28rpx;
}

.banner-dots {
  display: flex;
  gap: 12rpx;
}

.banner-dot {
  width: 16rpx;
  height: 6rpx;
  border-radius: 3rpx;
  background: rgba(255, 255, 255, 0.25);
  transition: all 0.3s ease;
}

.banner-dot.is-active {
  width: 40rpx;
  background: var(--gradient-neon);
  box-shadow: 0 0 10rpx rgba(0, 240, 255, 0.6);
}

/* ===================================
   GROUPS - 折叠面板
   =================================== */

.groups {
  position: relative;
  z-index: 1;
  padding: 0 24rpx 40rpx;
}

.group {
  margin-bottom: 24rpx;
}

.group-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 28rpx 32rpx;
  border-radius: var(--radius-lg);
  transition: all 0.3s ease;
}

.group-header:active {
  transform: scale(0.99);
  background: rgba(255, 255, 255, 0.12);
}

.group-header-left {
  display: flex;
  align-items: center;
  flex: 1;
  min-width: 0;
}

.group-icon {
  width: 72rpx;
  height: 72rpx;
  border-radius: 20rpx;
  margin-right: 24rpx;
  position: relative;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(0, 240, 255, 0.12);
  border: 1rpx solid rgba(0, 240, 255, 0.3);
  box-shadow: inset 0 0 12rpx rgba(0, 240, 255, 0.15);
}

.group-icon--ai {
  background: linear-gradient(135deg, rgba(0, 240, 255, 0.25) 0%, rgba(255, 0, 128, 0.2) 100%);
  border-color: rgba(255, 0, 128, 0.4);
  box-shadow: inset 0 0 16rpx rgba(255, 0, 128, 0.2), 0 0 16rpx rgba(0, 240, 255, 0.15);
}

.group-icon--basic {
  background: linear-gradient(135deg, rgba(0, 240, 255, 0.2) 0%, rgba(0, 240, 255, 0.05) 100%);
  border-color: rgba(0, 240, 255, 0.4);
}

.group-icon--creative {
  background: linear-gradient(135deg, rgba(255, 0, 128, 0.2) 0%, rgba(255, 107, 53, 0.15) 100%);
  border-color: rgba(255, 107, 53, 0.4);
}

/* AI 图标：脉冲圆点 */
.group-icon--ai::before {
  content: '';
  width: 28rpx;
  height: 28rpx;
  border-radius: 50%;
  background: var(--gradient-neon);
  box-shadow: 0 0 12rpx rgba(0, 240, 255, 0.6);
  animation: aiDot 2s ease-in-out infinite;
}

.group-icon--ai::after {
  content: '';
  position: absolute;
  width: 8rpx;
  height: 8rpx;
  border-radius: 50%;
  background: var(--color-neon-cyan);
  top: 12rpx;
  right: 12rpx;
  box-shadow: 0 0 6rpx var(--color-neon-cyan);
}

@keyframes aiDot {
  0%, 100% { transform: scale(1);   box-shadow: 0 0 12rpx rgba(0, 240, 255, 0.6); }
  50%      { transform: scale(1.15); box-shadow: 0 0 20rpx rgba(255, 0, 128, 0.7); }
}

/* 基础图标：齿轮 */
.group-icon--basic::before {
  content: '';
  width: 36rpx;
  height: 36rpx;
  border-radius: 50%;
  border: 4rpx solid var(--color-neon-cyan);
  background: radial-gradient(circle, rgba(0, 240, 255, 0.3) 0%, transparent 70%);
  box-shadow: 0 0 10rpx rgba(0, 240, 255, 0.45);
  animation: rotate 6s linear infinite;
}

.group-icon--basic::after {
  content: '';
  position: absolute;
  width: 10rpx;
  height: 10rpx;
  border-radius: 50%;
  background: var(--color-neon-cyan);
  box-shadow: 0 0 8rpx var(--color-neon-cyan);
}

/* 创意图标：闪光 */
.group-icon--creative::before {
  content: '';
  width: 0;
  height: 0;
  border-left: 16rpx solid transparent;
  border-right: 16rpx solid transparent;
  border-bottom: 30rpx solid var(--color-hot-magenta);
  filter: drop-shadow(0 0 10rpx rgba(255, 0, 128, 0.7));
  animation: sparkle 1.6s ease-in-out infinite;
}

.group-icon--creative::after {
  content: '';
  position: absolute;
  width: 6rpx;
  height: 6rpx;
  border-radius: 50%;
  background: var(--color-solar-flare);
  top: 18rpx;
  right: 14rpx;
  box-shadow:
    0 0 6rpx var(--color-solar-flare),
    -18rpx 12rpx 0 -1rpx #ffea00,
    -18rpx 12rpx 6rpx -1rpx #ffea00;
  animation: sparkle 1.6s ease-in-out 0.4s infinite;
}

@keyframes sparkle {
  0%, 100% { transform: scale(1);   opacity: 1; }
  50%      { transform: scale(0.6); opacity: 0.6; }
}

.group-meta {
  flex: 1;
  min-width: 0;
}

.group-title {
  font-size: 32rpx;
  font-weight: 700;
  color: var(--color-white);
  letter-spacing: 2rpx;
  margin-bottom: 6rpx;
}

.group-sub {
  font-size: 22rpx;
  color: var(--color-gray-500);
  letter-spacing: 1rpx;
}

.group-chevron {
  width: 20rpx;
  height: 20rpx;
  border-right: 3rpx solid var(--color-neon-cyan);
  border-bottom: 3rpx solid var(--color-neon-cyan);
  transform: rotate(45deg);
  transition: transform 0.3s ease, border-color 0.3s ease;
  margin-right: 6rpx;
  filter: drop-shadow(0 0 4rpx rgba(0, 240, 255, 0.6));
}

.group-chevron.is-expanded {
  transform: rotate(-135deg);
  border-color: var(--color-hot-magenta);
  filter: drop-shadow(0 0 4rpx rgba(255, 0, 128, 0.6));
}

/* 折叠面板主体（带过渡） */
.group-body {
  max-height: 0;
  overflow: hidden;
  opacity: 0;
  transition: max-height 0.45s cubic-bezier(0.4, 0, 0.2, 1), opacity 0.35s ease;
}

.group-body.is-expanded {
  max-height: 4000rpx;
  opacity: 1;
}

/* ===================================
   TOOLS GRID
   =================================== */

.tools-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 20rpx;
  padding: 20rpx 0 4rpx;
}

.tool-card {
  /* 玻璃拟态 */
  background: rgba(255, 255, 255, 0.06);
  backdrop-filter: blur(20rpx);
  -webkit-backdrop-filter: blur(20rpx);
  border-radius: var(--radius-lg);
  padding: 40rpx 24rpx 28rpx;
  text-align: center;
  border: 1rpx solid rgba(255, 255, 255, 0.14);
  box-shadow:
    0 8rpx 32rpx rgba(0, 0, 0, 0.25),
    inset 0 1rpx 0 rgba(255, 255, 255, 0.08);
  transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
  position: relative;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  min-height: 264rpx;
  overflow: hidden;
}

/* 悬停高光 */
.tool-card::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: linear-gradient(135deg, rgba(0, 240, 255, 0.12) 0%, rgba(255, 0, 128, 0.06) 100%);
  opacity: 0;
  transition: opacity 0.4s;
  z-index: 0;
}

.tool-card:active {
  transform: scale(0.96) translateY(4rpx);
  border-color: var(--color-neon-cyan);
  box-shadow:
    0 0 24rpx rgba(0, 240, 255, 0.35),
    inset 0 1rpx 0 rgba(255, 255, 255, 0.1);
}

.tool-card:active::before {
  opacity: 1;
}

.tool-card.disabled {
  opacity: 0.4;
  filter: grayscale(0.8);
}

/* 新功能标识样式 */
.tool-card.new-feature {
  border-color: rgba(255, 0, 128, 0.4);
  background: rgba(255, 0, 128, 0.06);
}

.new-badge {
  position: absolute;
  top: 12rpx;
  right: 12rpx;
  background: linear-gradient(135deg, #ff0080 0%, #ff8000 100%);
  color: #ffffff;
  font-size: 18rpx;
  font-weight: bold;
  padding: 4rpx 12rpx;
  border-radius: 12rpx;
  box-shadow: 0 0 12rpx rgba(255, 0, 128, 0.6);
  z-index: 2;
  animation: badgePulse 2s ease-in-out infinite;
}

@keyframes badgePulse {
  0%, 100% {
    box-shadow: 0 0 12rpx rgba(255, 0, 128, 0.6);
    transform: scale(1);
  }
  50% {
    box-shadow: 0 0 20rpx rgba(255, 0, 128, 0.9);
    transform: scale(1.05);
  }
}

/* ===================================
   CUSTOM CSS ICONS - 基础处理图标
   =================================== */

.tool-icon {
  width: 96rpx;
  height: 96rpx;
  margin-bottom: 24rpx;
  position: relative;
  z-index: 1;
}

/* Compress Icon - 外框套内块向心收缩（压缩=把图压小） */
.icon-compress {
  width: 96rpx;
  height: 96rpx;
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
}

.icon-compress::before {
  content: '';
  position: absolute;
  width: 64rpx;
  height: 64rpx;
  border: 3rpx solid var(--color-neon-cyan);
  border-radius: 10rpx;
  box-shadow: 0 0 12rpx rgba(0, 240, 255, 0.4);
}

.icon-compress::after {
  content: '';
  position: absolute;
  width: 40rpx;
  height: 40rpx;
  background: linear-gradient(135deg, var(--color-neon-cyan) 0%, var(--color-hot-magenta) 100%);
  border-radius: 6rpx;
  box-shadow: 0 0 14rpx rgba(255, 0, 128, 0.5);
  animation: compressShrink 2s ease-in-out infinite;
}

@keyframes compressShrink {
  0%, 100% { transform: scale(1); opacity: 1; }
  50% { transform: scale(0.5); opacity: 0.7; }
}

/* Crop Icon - 裁剪框 + 四角手柄（框发光呼吸，手柄脉冲） */
.icon-crop {
  width: 96rpx;
  height: 96rpx;
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
}

.icon-crop::before {
  content: '';
  position: absolute;
  width: 64rpx;
  height: 64rpx;
  border: 3rpx solid var(--color-neon-cyan);
  border-radius: 6rpx;
  box-shadow: 0 0 10rpx rgba(0, 240, 255, 0.3);
  animation: cropFrameGlow 2s ease-in-out infinite;
}

.icon-crop::after {
  content: '';
  position: absolute;
  width: 10rpx;
  height: 10rpx;
  background: transparent;
  border-radius: 2rpx;
  box-shadow:
    -28rpx -28rpx 0 0 var(--color-hot-magenta),
     28rpx -28rpx 0 0 var(--color-hot-magenta),
    -28rpx  28rpx 0 0 var(--color-hot-magenta),
     28rpx  28rpx 0 0 var(--color-hot-magenta);
  animation: handlePulse 1.8s ease-in-out infinite;
}

@keyframes cropFrameGlow {
  0%, 100% { box-shadow: 0 0 10rpx rgba(0, 240, 255, 0.3); }
  50% { box-shadow: 0 0 20rpx rgba(0, 240, 255, 0.65); }
}

@keyframes handlePulse {
  0%, 100% { opacity: 0.6; }
  50% { opacity: 1; }
}

/* Convert Icon - Circular Arrows */
.icon-convert {
  width: 96rpx;
  height: 96rpx;
  position: relative;
  border-radius: 50%;
  border: 3rpx solid transparent;
  border-top-color: var(--color-neon-cyan);
  border-right-color: var(--color-neon-cyan);
  box-shadow: 0 0 12rpx var(--color-neon-cyan);
  animation: rotate 2s linear infinite;
}

@keyframes rotate {
  from { transform: rotate(0deg); }
  to { transform: rotate(360deg); }
}

.icon-convert::before {
  content: '';
  position: absolute;
  width: 0;
  height: 0;
  border-top: 16rpx solid transparent;
  border-bottom: 16rpx solid transparent;
  border-left: 20rpx solid var(--color-hot-magenta);
  top: 50%;
  left: 50%;
  transform: translate(-25%, -50%);
  filter: drop-shadow(0 0 6rpx var(--color-hot-magenta));
}

/* Watermark Icon - 图片 + 右下角版权印章盖章 */
.icon-watermark {
  width: 96rpx;
  height: 96rpx;
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
}

.icon-watermark::before {
  content: '';
  position: absolute;
  width: 60rpx;
  height: 60rpx;
  border: 3rpx solid var(--color-neon-cyan);
  border-radius: 10rpx;
  background: linear-gradient(135deg, rgba(0, 240, 255, 0.12) 0%, rgba(255, 0, 128, 0.08) 100%);
  box-shadow: 0 0 12rpx rgba(0, 240, 255, 0.3);
}

.icon-watermark::after {
  content: '©';
  position: absolute;
  width: 32rpx;
  height: 32rpx;
  bottom: 14rpx;
  right: 14rpx;
  border-radius: 50%;
  background: var(--color-hot-magenta);
  color: #ffffff;
  font-size: 22rpx;
  font-weight: bold;
  line-height: 32rpx;
  text-align: center;
  box-shadow: 0 0 12rpx rgba(255, 0, 128, 0.6);
  animation: stampPress 2s ease-in-out infinite;
}

@keyframes stampPress {
  0%, 100% { transform: scale(1); box-shadow: 0 0 10rpx rgba(255, 0, 128, 0.5); }
  50% { transform: scale(1.18); box-shadow: 0 0 18rpx rgba(255, 0, 128, 0.9); }
}

/* Filter Icon - Diamond Grid */
.icon-filter {
  width: 96rpx;
  height: 96rpx;
  position: relative;
  background: linear-gradient(45deg,
    var(--color-neon-cyan) 25%,
    transparent 25%,
    transparent 75%,
    var(--color-neon-cyan) 75%
  ),
  linear-gradient(-45deg,
    var(--color-hot-magenta) 25%,
    transparent 25%,
    transparent 75%,
    var(--color-hot-magenta) 75%
  );
  background-size: 32rpx 32rpx;
  background-position: 0 0, 16rpx 16rpx;
  box-shadow: 0 0 20rpx rgba(0, 240, 255, 0.3);
  animation: filterShift 3s ease-in-out infinite;
}

@keyframes filterShift {
  0%, 100% { opacity: 1; }
  50% { opacity: 0.7; }
}

/* Splice Icon - Linked Squares */
.icon-splice {
  width: 96rpx;
  height: 96rpx;
  position: relative;
}

.icon-splice::before {
  content: '';
  position: absolute;
  width: 36rpx;
  height: 36rpx;
  background: var(--color-neon-cyan);
  left: 8rpx;
  top: 50%;
  transform: translateY(-50%);
  box-shadow: 0 0 12rpx var(--color-neon-cyan);
}

.icon-splice::after {
  content: '';
  position: absolute;
  width: 36rpx;
  height: 36rpx;
  background: var(--color-hot-magenta);
  right: 8rpx;
  top: 50%;
  transform: translateY(-50%);
  box-shadow: 0 0 12rpx var(--color-hot-magenta);
}

/* ===================================
   AI TOOL ICONS - NEW DYNAMIC DESIGNS
   =================================== */

/* AI Describe Icon - 图片 + 右侧识别出的文字流 */
.icon-aiDescribe {
  width: 96rpx;
  height: 96rpx;
  position: relative;
  display: flex;
  align-items: center;
}

.icon-aiDescribe::before {
  content: '';
  position: absolute;
  width: 36rpx;
  height: 36rpx;
  left: 12rpx;
  top: 50%;
  transform: translateY(-50%);
  border: 3rpx solid var(--color-neon-cyan);
  border-radius: 8rpx;
  background: linear-gradient(135deg, rgba(0, 240, 255, 0.2) 0%, rgba(255, 0, 128, 0.15) 100%);
  box-shadow: 0 0 12rpx rgba(0, 240, 255, 0.4);
}

.icon-aiDescribe::after {
  content: '';
  position: absolute;
  right: 10rpx;
  top: 50%;
  transform: translateY(-50%);
  width: 32rpx;
  height: 36rpx;
  background:
    linear-gradient(var(--color-neon-cyan), var(--color-neon-cyan)) 0 0 / 100% 4rpx no-repeat,
    linear-gradient(var(--color-hot-magenta), var(--color-hot-magenta)) 0 16rpx / 75% 4rpx no-repeat,
    linear-gradient(var(--color-neon-cyan), var(--color-neon-cyan)) 0 32rpx / 90% 4rpx no-repeat;
  animation: describeScan 1.8s ease-in-out infinite;
}

@keyframes describeScan {
  0%, 100% { opacity: 0.5; transform: translateY(-50%) translateX(0); }
  50% { opacity: 1; transform: translateY(-50%) translateX(4rpx); }
}

/* AI Caption Icon - 图片 + 下方生成的配文行 */
.icon-aiCaption {
  width: 96rpx;
  height: 96rpx;
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
}

.icon-aiCaption::before {
  content: '';
  position: absolute;
  width: 44rpx;
  height: 32rpx;
  top: 18rpx;
  left: 50%;
  transform: translateX(-50%);
  border: 3rpx solid var(--color-neon-cyan);
  border-radius: 8rpx;
  background: linear-gradient(135deg, rgba(0, 240, 255, 0.15) 0%, rgba(255, 0, 128, 0.12) 100%);
  box-shadow: 0 0 12rpx rgba(0, 240, 255, 0.4);
}

.icon-aiCaption::after {
  content: '';
  position: absolute;
  bottom: 20rpx;
  left: 50%;
  transform: translateX(-50%);
  width: 56rpx;
  height: 4rpx;
  border-radius: 2rpx;
  background: linear-gradient(90deg, var(--color-neon-cyan), var(--color-hot-magenta));
  box-shadow: 0 0 12rpx rgba(0, 240, 255, 0.6);
  animation: captionType 1.5s ease-in-out infinite;
}

@keyframes captionType {
  0%, 100% { width: 56rpx; opacity: 1; }
  50% { width: 30rpx; opacity: 0.6; }
}

/* AI Chat Icon - 图片相框(左上青) + 对话气泡(右下粉,内含三点,呼吸缩放) */
.icon-aiChat {
  width: 96rpx;
  height: 96rpx;
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
}

.icon-aiChat::before {
  content: '';
  position: absolute;
  width: 42rpx;
  height: 32rpx;
  top: 22rpx;
  left: 16rpx;
  border: 3rpx solid var(--color-neon-cyan);
  border-radius: 8rpx;
  background: linear-gradient(135deg, rgba(0, 240, 255, 0.2) 0%, rgba(255, 0, 128, 0.15) 100%);
  box-shadow: 0 0 12rpx rgba(0, 240, 255, 0.4);
}

.icon-aiChat::after {
  content: '';
  position: absolute;
  width: 40rpx;
  height: 32rpx;
  bottom: 20rpx;
  right: 14rpx;
  border: 3rpx solid var(--color-hot-magenta);
  border-radius: 10rpx;
  background-color: rgba(255, 0, 128, 0.08);
  background-image: radial-gradient(circle, var(--color-hot-magenta) 2.5rpx, transparent 3rpx);
  background-size: 12rpx 100%;
  background-repeat: repeat-x;
  background-position: 8rpx center;
  box-shadow: 0 0 12rpx rgba(255, 0, 128, 0.35);
  animation: chatBubble 1.8s ease-in-out infinite;
}

@keyframes chatBubble {
  0%, 100% { transform: scale(1); box-shadow: 0 0 12rpx rgba(255, 0, 128, 0.35); }
  50% { transform: scale(1.1); box-shadow: 0 0 18rpx rgba(255, 0, 128, 0.6); }
}

/* AI Matting Icon - 主体方块从虚线底板抠起浮起 */
.icon-aiMatting {
  width: 96rpx;
  height: 96rpx;
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
}

.icon-aiMatting::before {
  content: '';
  position: absolute;
  width: 68rpx;
  height: 48rpx;
  bottom: 14rpx;
  left: 50%;
  transform: translateX(-50%);
  border: 2rpx dashed rgba(0, 240, 255, 0.5);
  border-radius: 8rpx;
  background: rgba(0, 240, 255, 0.06);
}

.icon-aiMatting::after {
  content: '';
  position: absolute;
  width: 40rpx;
  height: 40rpx;
  left: 50%;
  top: 50%;
  background: linear-gradient(135deg, var(--color-neon-cyan) 0%, var(--color-hot-magenta) 100%);
  border-radius: 8rpx;
  box-shadow: 0 6rpx 14rpx rgba(0, 0, 0, 0.4), 0 0 18rpx rgba(0, 240, 255, 0.5);
  animation: mattingLift 2s ease-in-out infinite;
}

@keyframes mattingLift {
  0%, 100% {
    transform: translate(-50%, -50%);
    box-shadow: 0 4rpx 10rpx rgba(0, 0, 0, 0.3), 0 0 14rpx rgba(0, 240, 255, 0.4);
  }
  50% {
    transform: translate(-50%, -75%);
    box-shadow: 0 12rpx 20rpx rgba(0, 0, 0, 0.45), 0 0 24rpx rgba(255, 0, 128, 0.6);
  }
}

/* AI Style Icon - Color Palette */
.icon-aiStyle {
  width: 96rpx;
  height: 96rpx;
  position: relative;
}

.icon-aiStyle::before {
  content: '';
  position: absolute;
  width: 72rpx;
  height: 72rpx;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  background: conic-gradient(
    from 0deg,
    var(--color-neon-cyan) 0deg,
    var(--color-hot-magenta) 60deg,
    #ffff00 120deg,
    #00ff00 180deg,
    var(--color-neon-cyan) 240deg,
    var(--color-hot-magenta) 300deg,
    var(--color-neon-cyan) 360deg
  );
  border-radius: 50%;
  box-shadow: 0 0 30rpx rgba(255, 0, 128, 0.5);
  animation: colorRotate 3s linear infinite;
}

@keyframes colorRotate {
  from {
    transform: translate(-50%, -50%) rotate(0deg);
  }
  to {
    transform: translate(-50%, -50%) rotate(360deg);
  }
}

.icon-aiStyle::after {
  content: '';
  position: absolute;
  width: 30rpx;
  height: 30rpx;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  background: rgba(0, 0, 0, 0.3);
  border-radius: 50%;
  backdrop-filter: blur(10rpx);
  border: 2rpx solid rgba(255, 255, 255, 0.3);
}

/* AI OCR Icon - Document with text lines & magnifying glass */
.icon-aiOCR {
  width: 96rpx;
  height: 96rpx;
  position: relative;
}

.icon-aiOCR::before {
  content: '';
  position: absolute;
  width: 60rpx;
  height: 72rpx;
  top: 50%;
  left: 50%;
  transform: translate(-55%, -50%);
  background: linear-gradient(135deg, rgba(0, 240, 255, 0.2) 0%, rgba(255, 0, 128, 0.2) 100%);
  border: 2rpx solid var(--color-neon-cyan);
  border-radius: 6rpx;
  box-shadow: 0 0 15rpx rgba(0, 240, 255, 0.3);
}

.icon-aiOCR::after {
  content: '';
  position: absolute;
  width: 40rpx;
  height: 36rpx;
  top: 50%;
  left: 50%;
  transform: translate(-55%, -45%);
  background:
    linear-gradient(to right, var(--color-neon-cyan) 100%, transparent 0) 0 0 / 100% 4rpx no-repeat,
    linear-gradient(to right, var(--color-hot-magenta) 70%, transparent 0) 0 14rpx / 100% 4rpx no-repeat,
    linear-gradient(to right, var(--color-neon-cyan) 85%, transparent 0) 0 28rpx / 100% 4rpx no-repeat;
  animation: textScan 2s ease-in-out infinite;
}

@keyframes textScan {
  0%, 100% { opacity: 0.6; }
  50% { opacity: 1; }
}

/* AI Eraser Icon - Magic eraser with sparkle effect */
.icon-aiEraser {
  width: 96rpx;
  height: 96rpx;
  position: relative;
}

.icon-aiEraser::before {
  content: '';
  position: absolute;
  width: 50rpx;
  height: 60rpx;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%) rotate(-15deg);
  background: linear-gradient(180deg,
    var(--color-neon-cyan) 0%,
    var(--color-neon-cyan) 40%,
    var(--color-hot-magenta) 40%,
    var(--color-hot-magenta) 100%
  );
  border-radius: 6rpx 6rpx 12rpx 12rpx;
  box-shadow: 0 0 20rpx rgba(0, 240, 255, 0.5);
  animation: eraserFloat 2s ease-in-out infinite;
}

@keyframes eraserFloat {
  0%, 100% {
    transform: translate(-50%, -50%) rotate(-15deg);
    box-shadow: 0 0 20rpx rgba(0, 240, 255, 0.5);
  }
  50% {
    transform: translate(-50%, -55%) rotate(-12deg);
    box-shadow: 0 0 30rpx rgba(255, 0, 128, 0.6);
  }
}

.icon-aiEraser::after {
  content: '';
  position: absolute;
  width: 12rpx;
  height: 12rpx;
  top: 10rpx;
  right: 8rpx;
  background: var(--color-neon-cyan);
  border-radius: 50%;
  box-shadow:
    0 0 8rpx var(--color-neon-cyan),
    -15rpx 20rpx 0 -2rpx var(--color-hot-magenta),
    -15rpx 20rpx 6rpx -2rpx var(--color-hot-magenta),
    10rpx 30rpx 0 -3rpx var(--color-neon-cyan),
    10rpx 30rpx 6rpx -3rpx var(--color-neon-cyan);
  animation: sparklePulse 1.5s ease-in-out infinite;
}

@keyframes sparklePulse {
  0%, 100% { opacity: 1; transform: scale(1); }
  50% { opacity: 0.6; transform: scale(0.8); }
}

/* ===================================
   TOOL CARD CONTENT
   =================================== */

.tool-name {
  font-size: 28rpx;
  font-weight: 700;
  color: var(--color-white);
  margin-bottom: 12rpx;
  letter-spacing: 1rpx;
  position: relative;
  z-index: 1;
}

.tool-desc {
  font-size: 22rpx;
  color: var(--color-gray-500);
  line-height: 1.4;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
  text-overflow: ellipsis;
  position: relative;
  z-index: 1;
}

.tool-status {
  position: absolute;
  top: 16rpx;
  right: 16rpx;
  background: rgba(0, 240, 255, 0.1);
  color: var(--color-neon-cyan);
  font-size: 20rpx;
  padding: 6rpx 16rpx;
  border-radius: 20rpx;
  border: 1rpx solid var(--color-neon-cyan);
  backdrop-filter: blur(10rpx);
  z-index: 2;
}

/* ===================================
   FEATURES SECTION - CARDS
   =================================== */

.features {
  background: rgba(255, 255, 255, 0.04);
  backdrop-filter: blur(20rpx);
  -webkit-backdrop-filter: blur(20rpx);
  border-radius: var(--radius-lg);
  padding: 40rpx;
  margin: 0 24rpx 40rpx;
  border: 1rpx solid rgba(0, 240, 255, 0.15);
  position: relative;
  z-index: 1;
  box-shadow: 0 8rpx 32rpx rgba(0, 0, 0, 0.2);
}

.features::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 2rpx;
  background: var(--gradient-neon);
  opacity: 0.5;
}

.feature-item {
  display: flex;
  align-items: center;
  margin-bottom: 24rpx;
}

.feature-item:last-child {
  margin-bottom: 0;
}

.feature-icon {
  width: 48rpx;
  height: 48rpx;
  margin-right: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--gradient-neon);
  border-radius: 50%;
  font-size: 24rpx;
  box-shadow: var(--shadow-neon);
}

.feature-text {
  font-size: 26rpx;
  color: var(--color-gray-200);
  letter-spacing: 1rpx;
}

/* ===================================
   FOOTER
   =================================== */

.footer {
  text-align: center;
  padding: 40rpx 0 80rpx;
  position: relative;
  z-index: 1;
}

.footer-text {
  font-size: 22rpx;
  color: var(--color-gray-500);
  letter-spacing: 2rpx;
  opacity: 0.6;
}

.footer::before {
  content: '';
  position: absolute;
  top: 0;
  left: 50%;
  transform: translateX(-50%);
  width: 120rpx;
  height: 2rpx;
  background: var(--gradient-neon);
}

