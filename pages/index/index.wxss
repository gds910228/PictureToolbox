/* ===================================
   AI UPSCALE ICON - 中心图块呼吸放大 + 外扩波纹
   语义：原图 → AI 超分辨率放大，分辨率向外提升
   =================================== */

.icon-aiUpscale {
  width: 96rpx;
  height: 96rpx;
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
}

/* 中心原图块：渐变填充 + 呼吸放大（AI 增强细节） */
.icon-aiUpscale::before {
  content: '';
  position: absolute;
  width: 40rpx;
  height: 40rpx;
  top: 50%;
  left: 50%;
  border-radius: 8rpx;
  background: linear-gradient(135deg, var(--color-neon-cyan) 0%, var(--color-hot-magenta) 100%);
  transform: translate(-50%, -50%) scale(0.85);
  box-shadow: 0 0 18rpx rgba(0, 240, 255, 0.6);
  animation: upscaleCore 2s ease-in-out infinite;
  z-index: 2;
}

@keyframes upscaleCore {
  0%, 100% {
    transform: translate(-50%, -50%) scale(0.8);
    box-shadow: 0 0 18rpx rgba(0, 240, 255, 0.6);
  }
  50% {
    transform: translate(-50%, -50%) scale(1.12);
    box-shadow: 0 0 28rpx rgba(255, 0, 128, 0.75);
  }
}

/* 外扩波纹框：从中心向外扩散并淡出（放大扩散波） */
.icon-aiUpscale::after {
  content: '';
  position: absolute;
  width: 40rpx;
  height: 40rpx;
  top: 50%;
  left: 50%;
  border: 3rpx solid var(--color-neon-cyan);
  border-radius: 10rpx;
  transform: translate(-50%, -50%) scale(0.8);
  opacity: 0.9;
  box-shadow: 0 0 12rpx rgba(0, 240, 255, 0.4);
  animation: upscaleWave 2s ease-out infinite;
  z-index: 1;
}

@keyframes upscaleWave {
  0% {
    transform: translate(-50%, -50%) scale(0.8);
    opacity: 0.9;
    border-color: var(--color-neon-cyan);
  }
  70% {
    border-color: var(--color-hot-magenta);
  }
  100% {
    transform: translate(-50%, -50%) scale(2.2);
    opacity: 0;
    border-color: var(--color-hot-magenta);
  }
}

/* ============================================================
 * AI 老照片上色图标：一张「照片」从左到右被色彩铺满（上色过程）。
 *   ::before = 黑白照片底图（灰阶，上浅下深暗示天空/地面）
 *   ::after  = 彩色层，从左缘横向 scaleX 铺开 → 直观表达「黑白变彩色」
 * ============================================================ */
.icon-aiColorize {
  width: 96rpx;
  height: 96rpx;
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
}

/* 黑白照片底图：灰阶圆角矩形（上浅下深，暗示风景照） */
.icon-aiColorize::before {
  content: '';
  position: absolute;
  left: 21rpx;
  top: 27rpx;
  width: 54rpx;
  height: 42rpx;
  border-radius: 8rpx;
  background: linear-gradient(180deg, #6b7896 0%, #3f4860 100%);
  z-index: 1;
}

/* 彩色层：从左缘横向铺开（上色扫过），覆盖底图 */
.icon-aiColorize::after {
  content: '';
  position: absolute;
  left: 21rpx;
  top: 27rpx;
  width: 54rpx;
  height: 42rpx;
  border-radius: 8rpx;
  background: linear-gradient(180deg, var(--color-neon-cyan) 0%, #38ef7d 55%, var(--color-hot-magenta) 100%);
  transform-origin: 0 50%;
  transform: scaleX(0);
  box-shadow: 2rpx 0 10rpx rgba(0, 240, 255, 0.5);
  animation: colorizeWipe 2.8s ease-in-out infinite;
  z-index: 2;
}

@keyframes colorizeWipe {
  0%, 100% { transform: scaleX(0); }
  45%, 70% { transform: scaleX(1); }
}

/* ===================================
   SIMILARITY ICON - 两个错位方框（双图对比）
   =================================== */
.icon-similarity {
  width: 96rpx;
  height: 96rpx;
  position: relative;
}
.icon-similarity::before {
  content: '';
  position: absolute;
  width: 44rpx;
  height: 44rpx;
  left: 12rpx;
  top: 50%;
  transform: translateY(-50%);
  border: 3rpx solid var(--color-neon-cyan);
  border-radius: 8rpx;
  background: rgba(0, 240, 255, 0.12);
  box-shadow: 0 0 14rpx rgba(0, 240, 255, 0.5);
  animation: similarityPulse 2.4s ease-in-out infinite;
}
.icon-similarity::after {
  content: '';
  position: absolute;
  width: 44rpx;
  height: 44rpx;
  right: 12rpx;
  top: 50%;
  transform: translateY(-50%);
  border: 3rpx solid var(--color-hot-magenta);
  border-radius: 8rpx;
  background: rgba(255, 0, 128, 0.12);
  box-shadow: 0 0 14rpx rgba(255, 0, 128, 0.5);
}
@keyframes similarityPulse {
  0%, 100% { transform: translateY(-50%) scale(1); opacity: 1; }
  50% { transform: translateY(-50%) scale(0.92); opacity: 0.75; }
}

