.container { min-height: 100vh; background: linear-gradient(135deg, #0A0E27 0%, #1a1f3a 100%); padding: 20rpx; }
.page-header { text-align: center; padding: 40rpx 0; }
.page-title { display: block; font-size: 48rpx; font-weight: bold; color: #fff; margin-bottom: 10rpx; }
.page-subtitle { display: block; font-size: 28rpx; color: #8b9dc3; }
.image-section { background: rgba(255,255,255,0.05); border-radius: 20rpx; padding: 20rpx; margin-bottom: 30rpx; }
.preview-image { width: 100%; height: 400rpx; border-radius: 12rpx; background: rgba(255,255,255,0.1); }
.preview-image.placeholder { display: flex; align-items: center; justify-content: center; background: rgba(255,255,255,0.05); position: relative; }
.preview-image.placeholder::after { content: '点击上传图片'; position: absolute; color: #8b9dc3; font-size: 28rpx; }
.section-title { font-size: 32rpx; color: #fff; margin-bottom: 20rpx; font-weight: bold; }
.platform-section, .topic-section { margin-bottom: 30rpx; }
.platform-list { display: flex; flex-wrap: wrap; gap: 15rpx; }
.platform-item { flex: 1; min-width: 45%; background: rgba(255,255,255,0.05); border-radius: 12rpx; padding: 20rpx; text-align: center; border: 2rpx solid transparent; }
.platform-item.active { background: rgba(102,126,234,0.2); border-color: #667eea; }
.platform-icon { display: block; font-size: 36rpx; margin-bottom: 8rpx; }
.platform-label { font-size: 28rpx; color: #fff; }
.topic-input { width: 100%; height: 80rpx; background: rgba(255,255,255,0.1); border-radius: 12rpx; padding: 0 20rpx; color: #fff; font-size: 28rpx; }
.generate-btn { width: 100%; height: 90rpx; background: linear-gradient(135deg, #667eea 0%, #764ba2 100%); color: #fff; border-radius: 45rpx; font-size: 32rpx; font-weight: bold; border: none; }
.generate-btn[disabled] { background: rgba(255,255,255,0.1); color: #8b9dc3; }
.results-section { margin-top: 30rpx; }
.caption-item { background: rgba(255,255,255,0.05); border-radius: 12rpx; padding: 20rpx; margin-bottom: 15rpx; }
.caption-text { font-size: 28rpx; color: #fff; line-height: 1.6; display: block; margin-bottom: 15rpx; }
.copy-btn { width: 120rpx; height: 60rpx; background: rgba(102,126,234,0.3); color: #667eea; border-radius: 30rpx; font-size: 24rpx; border: none; }
