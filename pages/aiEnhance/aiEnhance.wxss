.container { min-height: 100vh; background: linear-gradient(135deg, #0A0E27 0%, #1a1f3a 100%); padding: 20rpx; }
.page-header { text-align: center; padding: 40rpx 0; }
.page-title { display: block; font-size: 48rpx; font-weight: bold; color: #fff; margin-bottom: 10rpx; }
.page-subtitle { display: block; font-size: 28rpx; color: #8b9dc3; }
.image-section { background: rgba(255,255,255,0.05); border-radius: 20rpx; padding: 20rpx; margin-bottom: 30rpx; }
.image-row { display: flex; gap: 15rpx; }
.image-box { flex: 1; }
.box-label { display: block; font-size: 24rpx; color: #8b9dc3; margin-bottom: 10rpx; text-align: center; }
.box-image { width: 100%; height: 300rpx; border-radius: 12rpx; background: rgba(255,255,255,0.1); }
.box-image.placeholder { display: flex; align-items: center; justify-content: center; background: rgba(255,255,255,0.05); position: relative; }
.box-image.placeholder::after { content: '点击上传'; position: absolute; color: #8b9dc3; font-size: 24rpx; }
.section-title { font-size: 32rpx; color: #fff; margin-bottom: 20rpx; font-weight: bold; }
.type-section { margin-bottom: 30rpx; }
.type-list { display: flex; flex-wrap: wrap; gap: 15rpx; }
.type-item { flex: 1; min-width: 30%; background: rgba(255,255,255,0.05); border-radius: 12rpx; padding: 20rpx; text-align: center; border: 2rpx solid transparent; }
.type-item.active { background: rgba(102,126,234,0.2); border-color: #667eea; }
.type-icon { display: block; font-size: 36rpx; margin-bottom: 8rpx; }
.type-label { display: block; font-size: 28rpx; color: #fff; margin-bottom: 5rpx; }
.type-desc { display: block; font-size: 22rpx; color: #8b9dc3; }
.generate-btn { width: 100%; height: 90rpx; background: linear-gradient(135deg, #667eea 0%, #764ba2 100%); color: #fff; border-radius: 45rpx; font-size: 32rpx; font-weight: bold; border: none; }
.generate-btn[disabled] { background: rgba(255,255,255,0.1); color: #8b9dc3; }
.action-section { margin-top: 20rpx; }
.action-btn { width: 100%; height: 80rpx; background: rgba(102,126,234,0.3); color: #667eea; border-radius: 40rpx; font-size: 28rpx; border: none; }
