/* pages/aiMatting/aiMatting.wxss */
.container {
  min-height: 100vh;
  background: linear-gradient(135deg, #0A0E27 0%, #1a1f3a 100%);
  padding: 20rpx;
}

.page-header {
  text-align: center;
  padding: 40rpx 0;
}

.page-title {
  display: block;
  font-size: 48rpx;
  font-weight: bold;
  color: #fff;
  margin-bottom: 10rpx;
}

.page-subtitle {
  display: block;
  font-size: 28rpx;
  color: #8b9dc3;
}

.image-section {
  background: rgba(255, 255, 255, 0.05);
  border-radius: 20rpx;
  padding: 20rpx;
  margin-bottom: 30rpx;
}

.image-row {
  display: flex;
  gap: 15rpx;
}

.image-box {
  flex: 1;
}

.box-label {
  display: block;
  font-size: 24rpx;
  color: #8b9dc3;
  margin-bottom: 10rpx;
  text-align: center;
}

.box-image {
  width: 100%;
  height: 300rpx;
  border-radius: 12rpx;
  background: rgba(255, 255, 255, 0.1);
  position: relative;
}

.box-image.placeholder {
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(255, 255, 255, 0.05);
}

.box-image.placeholder::after {
  content: '点击上传';
  position: absolute;
  color: #8b9dc3;
  font-size: 24rpx;
}

.box-image-result {
  width: 100%;
  height: 300rpx;
  border-radius: 12rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  position: relative;
  overflow: hidden;
}

.box-result-container {
  width: 100%;
  height: 100%;
  border-radius: 12rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  position: relative;
  overflow: hidden;
}

.box-result-container.placeholder {
  background: rgba(255, 255, 255, 0.05);
}

.tap-hint {
  position: absolute;
  bottom: 20rpx;
  left: 50%;
  transform: translateX(-50%);
  color: #8b9dc3;
  font-size: 22rpx;
}

.placeholder-text {
  color: #8b9dc3;
  font-size: 24rpx;
}

.result-image {
  width: 100%;
  height: 100%;
}

.result-image.transparent-bg {
  /* 透明背景图片的样式 */
  mix-blend-mode: normal;
}

.debug-section {
  margin-top: 20rpx;
  padding: 20rpx;
  background: rgba(255, 100, 100, 0.1);
  border-radius: 12rpx;
}

.debug-text {
  color: #ff6b6b;
  font-size: 22rpx;
  word-break: break-all;
}

.section-title {
  font-size: 32rpx;
  color: #fff;
  margin-bottom: 20rpx;
  font-weight: bold;
}

.type-section {
  margin-bottom: 30rpx;
}

.type-list {
  display: flex;
  flex-wrap: wrap;
  gap: 15rpx;
}

.type-item {
  flex: 1;
  min-width: 45%;
  background: rgba(255, 255, 255, 0.05);
  border-radius: 12rpx;
  padding: 20rpx;
  text-align: center;
  border: 2rpx solid transparent;
}

.type-item.active {
  background: rgba(102, 126, 234, 0.2);
  border-color: #667eea;
}

.type-icon {
  display: block;
  font-size: 36rpx;
  margin-bottom: 8rpx;
}

.type-label {
  display: block;
  font-size: 28rpx;
  color: #fff;
  margin-bottom: 5rpx;
}

.type-desc {
  display: block;
  font-size: 22rpx;
  color: #8b9dc3;
}

.color-section {
  margin-bottom: 30rpx;
}

.color-list {
  display: flex;
  flex-wrap: wrap;
  gap: 15rpx;
}

.color-item {
  width: 22%;
  background: rgba(255, 255, 255, 0.05);
  border-radius: 12rpx;
  padding: 15rpx;
  text-align: center;
  border: 2rpx solid transparent;
}

.color-item.active {
  background: rgba(102, 126, 234, 0.2);
  border-color: #667eea;
}

.color-preview {
  width: 60rpx;
  height: 60rpx;
  border-radius: 8rpx;
  margin: 0 auto 10rpx;
}

.color-name {
  display: block;
  font-size: 22rpx;
  color: #fff;
}

.action-section {
  display: flex;
  flex-direction: column;
  gap: 15rpx;
}

.matting-btn {
  width: 100%;
  height: 90rpx;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  color: #fff;
  border-radius: 45rpx;
  font-size: 32rpx;
  font-weight: bold;
  border: none;
}

.matting-btn[disabled] {
  background: rgba(255, 255, 255, 0.1);
  color: #8b9dc3;
}

.save-btn {
  width: 100%;
  height: 80rpx;
  background: rgba(102, 126, 234, 0.3);
  color: #667eea;
  border-radius: 40rpx;
  font-size: 28rpx;
  border: none;
}

.save-btn[disabled] {
  background: rgba(255, 255, 255, 0.05);
  color: #8b9dc3;
}
