/* pages/aiMatting/aiMatting.wxss */
.container {
  min-height: 100vh;
  background: linear-gradient(135deg, #0A0E27 0%, #1a1f3a 100%);
  padding: 20rpx;
  padding-bottom: 40rpx;
}

.page-header {
  text-align: center;
  padding: 20rpx 0 30rpx;
}

.page-title {
  display: block;
  font-size: 48rpx;
  font-weight: bold;
  color: #fff;
  margin-bottom: 10rpx;
}

.page-subtitle {
  display: block;
  font-size: 28rpx;
  color: #8b9dc3;
}

/* 图片对比区域 */
.compare-section {
  display: flex;
  gap: 20rpx;
  margin-bottom: 20rpx;
}

.compare-item {
  flex: 1;
  background: rgba(255,255,255,0.05);
  border-radius: 20rpx;
  padding: 20rpx;
  border: 2rpx solid rgba(255,255,255,0.1);
}

.compare-title {
  font-size: 28rpx;
  color: #fff;
  margin-bottom: 15rpx;
  text-align: center;
  font-weight: bold;
}

.compare-box {
  width: 100%;
  height: 350rpx;
  background: rgba(0,0,0,0.2);
  border-radius: 12rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  position: relative;
  overflow: hidden;
}

.compare-box::after {
  content: '🔍';
  position: absolute;
  bottom: 10rpx;
  right: 10rpx;
  font-size: 32rpx;
  opacity: 0;
  transition: opacity 0.3s;
  z-index: 10;
}

.compare-box:active::after {
  opacity: 0.7;
}

.compare-image {
  width: 100%;
  height: 100%;
  border-radius: 12rpx;
  transition: transform 0.3s;
}

.compare-image:active {
  transform: scale(0.95);
}

.compare-image.transparent-bg {
  mix-blend-mode: normal;
}

.compare-tip {
  position: absolute;
  color: #8b9dc3;
  font-size: 24rpx;
  text-align: center;
}

.preview-tip {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  background: rgba(0,0,0,0.6);
  color: #fff;
  font-size: 22rpx;
  text-align: center;
  padding: 8rpx 0;
  border-radius: 0 0 12rpx 12rpx;
  pointer-events: none;
}

/* 控制栏 */
.control-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: rgba(102,126,234,0.1);
  border-radius: 20rpx;
  padding: 20rpx;
  margin-bottom: 30rpx;
  border: 2rpx solid rgba(102,126,234,0.3);
}

.selected-info-text {
  font-size: 24rpx;
  color: #fff;
  flex: 1;
}

.generate-btn-small {
  width: 200rpx;
  height: 70rpx;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  color: #fff;
  border-radius: 35rpx;
  font-size: 28rpx;
  font-weight: bold;
  border: none;
  line-height: 70rpx;
  padding: 0;
}

.generate-btn-small[disabled] {
  background: rgba(255,255,255,0.1);
  color: #8b9dc3;
}

/* 通用 section 标题（color-section 共用） */
.section-title {
  font-size: 32rpx;
  color: #fff;
  margin-bottom: 20rpx;
  font-weight: bold;
}

/* 引导提示卡 */
.hint-card {
  background: rgba(0, 240, 255, 0.06);
  border: 1rpx solid rgba(0, 240, 255, 0.2);
  border-radius: 16rpx;
  padding: 20rpx 24rpx;
  margin-bottom: 20rpx;
}

.hint-text {
  font-size: 24rpx;
  color: #b8c6e0;
  line-height: 1.5;
}

/* 失败态卡片（标准化错误 + 重试） */
.error-card {
  background: rgba(255, 0, 128, 0.08);
  border: 1rpx solid rgba(255, 0, 128, 0.3);
  border-radius: 16rpx;
  padding: 30rpx;
  margin-bottom: 30rpx;
  text-align: center;
}

.error-icon {
  font-size: 48rpx;
  color: var(--color-hot-magenta);
  margin-bottom: 12rpx;
  line-height: 1;
}

.error-text {
  font-size: 26rpx;
  color: #fff;
  line-height: 1.6;
  margin-bottom: 20rpx;
}

.retry-btn-small {
  width: 60%;
  height: 64rpx;
  line-height: 64rpx;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  color: #fff;
  border-radius: 32rpx;
  font-size: 26rpx;
  font-weight: bold;
  border: none;
  padding: 0;
}

/* 背景颜色选择区域 */
.color-section {
  margin-bottom: 20rpx;
}

.color-grid {
  display: flex;
  flex-wrap: wrap;
}

.color-item {
  width: 32%;
  margin-right: 2%;
  margin-bottom: 20rpx;
  box-sizing: border-box;
  background: rgba(255,255,255,0.05);
  border-radius: 12rpx;
  padding: 15rpx;
  text-align: center;
  border: 2rpx solid transparent;
  transition: all 0.3s;
}

.color-item:nth-child(3n) {
  margin-right: 0;
}

.color-item.active {
  background: rgba(102,126,234,0.2);
  border-color: #667eea;
  transform: scale(1.05);
}

.color-preview {
  width: 80rpx;
  height: 80rpx;
  border-radius: 8rpx;
  margin: 0 auto 10rpx;
}

.color-name {
  font-size: 24rpx;
  color: #fff;
  display: block;
}

/* 保存按钮 */
.save-btn-small {
  width: 100%;
  height: 60rpx;
  background: linear-gradient(135deg, #11998e 0%, #38ef7d 100%);
  color: #fff;
  border-radius: 30rpx;
  font-size: 26rpx;
  font-weight: bold;
  border: none;
  margin-top: 15rpx;
  line-height: 60rpx;
  padding: 0;
}

/* 对比按钮（霓虹蓝描边） */
.save-btn-small.compare-btn-small {
  background: transparent;
  color: var(--color-neon-cyan);
  border: 2rpx solid var(--color-neon-cyan);
  box-shadow: 0 0 12rpx rgba(0, 240, 255, 0.3);
  text-shadow: 0 0 8rpx rgba(0, 240, 255, 0.5);
}
