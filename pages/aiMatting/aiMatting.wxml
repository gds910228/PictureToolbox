<!--pages/aiMatting/aiMatting.wxml-->
<view class="container">
  <!-- 页面标题 -->
  <view class="page-header">
    <text class="page-title">AI智能抠图</text>
    <text class="page-subtitle">自动识别主体，一键去除背景</text>
  </view>

  <!-- 图片对比区域 -->
  <view class="image-section">
    <view class="image-row">
      <view class="image-box">
        <text class="box-label">原图</text>
        <image
          class="box-image {{imageSrc ? '' : 'placeholder'}}"
          src="{{imageSrc}}"
          mode="aspectFit"
          bindtap="chooseImage"
        />
        <text class="tap-hint" wx:if="{{!imageSrc}}">点击上传</text>
      </view>

      <view class="image-box">
        <text class="box-label">
          抠图后 {{isRealMatting ? '✅' : '📝'}}
        </text>
        <view class="box-result-container" style="background-color: {{selectedBgColor === 'transparent' ? '#f0f0f0' : selectedBgColor}}">
          <image
            wx:if="{{resultSrc}}"
            class="result-image {{isRealMatting ? 'transparent-bg' : ''}}"
            src="{{resultSrc}}"
            mode="aspectFit"
          />
          <text wx:else class="placeholder-text">等待抠图</text>
        </view>
      </view>
    </view>
  </view>

  <!-- 抠图类型选择 -->
  <view class="type-section">
    <view class="section-title">选择抠图类型</view>
    <view class="type-list">
      <view
        class="type-item {{selectedType === item.value ? 'active' : ''}}"
        wx:for="{{types}}"
        wx:key="value"
        data-type="{{item.value}}"
        bindtap="selectType"
      >
        <text class="type-icon">{{item.icon}}</text>
        <text class="type-label">{{item.label}}</text>
        <text class="type-desc">{{item.desc}}</text>
      </view>
    </view>
  </view>

  <!-- 背景颜色选择 -->
  <view class="color-section">
    <view class="section-title">选择背景颜色</view>
    <view class="color-list">
      <view
        class="color-item {{selectedBgColor === item.value ? 'active' : ''}}"
        wx:for="{{backgroundColors}}"
        wx:key="value"
        data-color="{{item.value}}"
        bindtap="selectBgColor"
      >
        <view class="color-preview" style="background-color: {{item.color}}; border: {{item.value === 'transparent' ? '2rpx dashed #999' : 'none'}}"></view>
        <text class="color-name">{{item.name}}</text>
      </view>
    </view>
  </view>

  <!-- 操作按钮 -->
  <view class="action-section">
    <button class="matting-btn" bindtap="startMatting" disabled="{{loading || !fileID}}">
      {{loading ? '处理中...' : '开始抠图'}}
    </button>
    <button class="save-btn" bindtap="saveResult" disabled="{{!resultSrc}}" wx:if="{{resultSrc}}">
      保存到相册
    </button>
  </view>

  <!-- 调试信息（开发时显示） -->
  <view class="debug-section" wx:if="{{debugInfo}}">
    <text class="debug-text">调试信息：{{debugInfo}}</text>
  </view>
</view>
