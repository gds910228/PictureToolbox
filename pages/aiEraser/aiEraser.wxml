<!--pages/aiEraser/aiEraser.wxml-->
<view class="container">
  <view class="page-header">
    <text class="page-title">AI 智能去水印</text>
    <text class="page-subtitle">涂抹水印区域，AI 一键修复</text>
  </view>

  <!-- Step 1: 选择图片 -->
  <view class="step-section" wx:if="{{!imageSrc}}">
    <view class="upload-box" bindtap="chooseImage">
      <view class="upload-icon">+</view>
      <text class="upload-text">点击选择图片</text>
      <text class="upload-hint">支持 JPG / PNG 格式</text>
    </view>
  </view>

  <!-- Step 2: 涂抹水印 -->
  <view class="step-section" wx:if="{{imageSrc && !resultSrc}}">
    <view class="canvas-wrapper" style="height: {{canvasHeight}}px;">
      <canvas
        type="2d"
        id="eraserCanvas"
        class="eraser-canvas"
        style="height: {{canvasHeight}}px;"
        bindtouchstart="onTouchStart"
        bindtouchmove="onTouchMove"
        bindtouchend="onTouchEnd"
        disable-scroll="true"
      ></canvas>
      <view class="canvas-tip" wx:if="{{!hasPainted}}">
        <text>👆 用手指涂抹需要去除的水印区域</text>
      </view>
    </view>

    <!-- 工具栏 -->
    <view class="tool-bar">
      <view class="tool-item">
        <text class="tool-label">笔刷大小</text>
        <slider
          class="brush-slider"
          min="5"
          max="80"
          value="{{brushSize}}"
          activeColor="#00F0FF"
          backgroundColor="rgba(255,255,255,0.1)"
          block-size="20"
          bindchange="onBrushSizeChange"
          show-value
        />
      </view>
      <view class="tool-actions">
        <button class="btn-undo" bindtap="undoLastStroke" disabled="{{strokeCount === 0}}">撤销</button>
        <button class="btn-clear" bindtap="clearMask">清除</button>
      </view>
    </view>

    <!-- 修复按钮 -->
    <view class="action-section">
      <button
        class="btn-repair"
        bindtap="startRepair"
        disabled="{{processing || !hasPainted}}"
      >
        <text wx:if="{{!processing}}">✨ 一键修复</text>
        <text wx:else>处理中 {{progress}}%</text>
      </button>
      <text class="degrade-tip" wx:if="{{processing}}">{{statusText}}</text>
    </view>

    <!-- 错误提示（降级提示） -->
    <view class="error-banner" wx:if="{{errorMsg}}">
      <text class="error-icon">⚠️</text>
      <text class="error-text">{{errorMsg}}</text>
    </view>
  </view>

  <!-- Step 3: 结果对比 -->
  <view class="step-section result-section" wx:if="{{resultSrc}}">
    <view class="result-compare">
      <view class="result-item">
        <view class="result-title">原图</view>
        <view class="result-box" bindtap="previewOriginal">
          <image class="result-image" src="{{imageSrc}}" mode="aspectFit" />
        </view>
      </view>
      <view class="result-item">
        <view class="result-title">修复后</view>
        <view class="result-box result-box-after" bindtap="previewResult">
          <image class="result-image" src="{{resultSrc}}" mode="aspectFit" />
          <view class="engine-tag" wx:if="{{engine}}">{{engineText}}</view>
        </view>
      </view>
    </view>

    <!-- 降级提示 -->
    <view class="degrade-banner" wx:if="{{degraded}}">
      <text class="degrade-icon">ℹ️</text>
      <text class="degrade-text">{{degradeReason}}</text>
    </view>

    <!-- 操作按钮 -->
    <view class="result-actions">
      <button class="btn-compare" bindtap="onCompare">对比查看</button>
      <button class="btn-save" bindtap="saveResult">保存到相册</button>
      <button class="btn-retry" bindtap="resetAll">重新处理</button>
    </view>
  </view>

  <!-- 功能说明 -->
  <view class="info-section" wx:if="{{!resultSrc}}">
    <view class="info-title">使用说明</view>
    <view class="info-list">
      <view class="info-item">
        <text class="info-num">1</text>
        <text class="info-text">选择带水印的图片</text>
      </view>
      <view class="info-item">
        <text class="info-num">2</text>
        <text class="info-text">用手指涂抹水印区域</text>
      </view>
      <view class="info-item">
        <text class="info-num">3</text>
        <text class="info-text">点击一键修复，AI 自动填充</text>
      </view>
    </view>
  </view>
</view>
