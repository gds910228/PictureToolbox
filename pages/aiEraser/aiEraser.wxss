/* pages/aiEraser/aiEraser.wxss */
.container {
  min-height: 100vh;
  background: linear-gradient(135deg, #0A0E27 0%, #1a1f3a 100%);
  padding: 20rpx;
  padding-bottom: 60rpx;
  box-sizing: border-box;
}

.page-header {
  text-align: center;
  padding: 20rpx 0 30rpx;
}

.page-title {
  display: block;
  font-size: 48rpx;
  font-weight: bold;
  color: #fff;
  margin-bottom: 10rpx;
  background: linear-gradient(135deg, #00F0FF 0%, #FF0080 100%);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
}

.page-subtitle {
  display: block;
  font-size: 26rpx;
  color: #8b9dc3;
}

/* ========== 上传区域 ========== */
.upload-box {
  width: 100%;
  height: 500rpx;
  background: rgba(255, 255, 255, 0.03);
  border: 2rpx dashed rgba(0, 240, 255, 0.3);
  border-radius: 20rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  margin-bottom: 30rpx;
  transition: all 0.3s;
}

.upload-box:active {
  border-color: #00F0FF;
  background: rgba(0, 240, 255, 0.05);
}

.upload-icon {
  font-size: 100rpx;
  color: rgba(0, 240, 255, 0.6);
  line-height: 1;
  margin-bottom: 20rpx;
}

.upload-text {
  font-size: 32rpx;
  color: #fff;
  margin-bottom: 10rpx;
}

.upload-hint {
  font-size: 24rpx;
  color: #8b9dc3;
}

/* ========== Canvas 区域 ========== */
.canvas-wrapper {
  position: relative;
  width: 100%;
  min-height: 400rpx;
  margin-bottom: 20rpx;
  background: rgba(0, 0, 0, 0.3);
  border-radius: 16rpx;
  overflow: hidden;
  border: 2rpx solid rgba(0, 240, 255, 0.15);
  display: flex;
  align-items: center;
  justify-content: center;
}

.eraser-canvas {
  width: 100%;
  display: block;
}

.canvas-tip {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  background: rgba(0, 0, 0, 0.7);
  color: #fff;
  padding: 20rpx 30rpx;
  border-radius: 40rpx;
  font-size: 26rpx;
  pointer-events: none;
  border: 1rpx solid rgba(0, 240, 255, 0.3);
  white-space: nowrap;
}

/* ========== 工具栏 ========== */
.tool-bar {
  background: rgba(255, 255, 255, 0.05);
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 24rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.08);
}

.tool-item {
  margin-bottom: 20rpx;
}

.tool-label {
  font-size: 26rpx;
  color: #fff;
  display: block;
  margin-bottom: 10rpx;
}

.brush-slider {
  width: 100%;
  margin: 0;
}

.tool-actions {
  display: flex;
  gap: 20rpx;
  justify-content: flex-end;
}

.btn-undo,
.btn-clear {
  flex: 1;
  height: 64rpx;
  line-height: 64rpx;
  font-size: 26rpx;
  border-radius: 32rpx;
  padding: 0;
  border: none;
}

.btn-undo {
  background: rgba(0, 240, 255, 0.15);
  color: #00F0FF;
  border: 1rpx solid rgba(0, 240, 255, 0.3);
}

.btn-undo[disabled] {
  opacity: 0.4;
  color: #8b9dc3;
  border-color: rgba(139, 157, 195, 0.2);
}

.btn-clear {
  background: rgba(255, 0, 128, 0.15);
  color: #FF0080;
  border: 1rpx solid rgba(255, 0, 128, 0.3);
}

/* ========== 修复按钮 ========== */
.action-section {
  margin-bottom: 24rpx;
  text-align: center;
}

.btn-repair {
  width: 100%;
  height: 96rpx;
  line-height: 96rpx;
  background: linear-gradient(135deg, #00F0FF 0%, #FF0080 100%);
  color: #0A0E27;
  font-size: 32rpx;
  font-weight: bold;
  border-radius: 48rpx;
  border: none;
  box-shadow: 0 0 30rpx rgba(0, 240, 255, 0.4);
  padding: 0;
}

.btn-repair[disabled] {
  background: rgba(255, 255, 255, 0.1);
  color: #8b9dc3;
  box-shadow: none;
}

.status-text {
  display: block;
  font-size: 24rpx;
  color: #8b9dc3;
  margin-top: 12rpx;
}

/* ========== 错误/降级提示 ========== */
.error-banner {
  background: rgba(255, 107, 53, 0.15);
  border: 1rpx solid rgba(255, 107, 53, 0.4);
  border-radius: 12rpx;
  padding: 20rpx;
  margin-bottom: 20rpx;
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.error-icon {
  font-size: 32rpx;
}

.error-text {
  font-size: 26rpx;
  color: #FF6B35;
  flex: 1;
}

/* ========== 结果区域 ========== */
.result-section {
  margin-bottom: 30rpx;
}

.result-compare {
  display: flex;
  gap: 16rpx;
  margin-bottom: 20rpx;
}

.result-item {
  flex: 1;
}

.result-title {
  font-size: 26rpx;
  color: #fff;
  text-align: center;
  margin-bottom: 12rpx;
  font-weight: bold;
}

.result-box {
  width: 100%;
  height: 380rpx;
  background: rgba(0, 0, 0, 0.3);
  border-radius: 12rpx;
  overflow: hidden;
  position: relative;
  border: 1rpx solid rgba(0, 240, 255, 0.15);
}

.result-box-after {
  border-color: rgba(0, 240, 255, 0.4);
}

.result-image {
  width: 100%;
  height: 100%;
}

.engine-tag {
  position: absolute;
  top: 10rpx;
  right: 10rpx;
  background: rgba(0, 240, 255, 0.8);
  color: #0A0E27;
  font-size: 20rpx;
  padding: 4rpx 12rpx;
  border-radius: 20rpx;
  font-weight: bold;
}

.degrade-banner {
  background: rgba(255, 200, 0, 0.1);
  border: 1rpx solid rgba(255, 200, 0, 0.3);
  border-radius: 12rpx;
  padding: 16rpx;
  margin-bottom: 20rpx;
  display: flex;
  align-items: flex-start;
  gap: 12rpx;
}

.degrade-icon {
  font-size: 28rpx;
  flex-shrink: 0;
}

.degrade-text {
  font-size: 24rpx;
  color: #FFD700;
  line-height: 1.5;
}

.result-actions {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.btn-compare,
.btn-save,
.btn-retry {
  width: 100%;
  height: 80rpx;
  line-height: 80rpx;
  font-size: 28rpx;
  border-radius: 40rpx;
  border: none;
  padding: 0;
}

.btn-compare {
  background: transparent;
  color: #00F0FF;
  border: 2rpx solid #00F0FF;
  box-shadow: 0 0 12rpx rgba(0, 240, 255, 0.3);
}

.btn-save {
  background: linear-gradient(135deg, #11998e 0%, #38ef7d 100%);
  color: #fff;
}

.btn-retry {
  background: rgba(255, 255, 255, 0.1);
  color: #fff;
  border: 1rpx solid rgba(255, 255, 255, 0.2);
}

/* ========== 使用说明 ========== */
.info-section {
  background: rgba(255, 255, 255, 0.03);
  border-radius: 16rpx;
  padding: 24rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.08);
}

.info-title {
  font-size: 28rpx;
  color: #fff;
  font-weight: bold;
  margin-bottom: 20rpx;
}

.info-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.info-item {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.info-num {
  width: 40rpx;
  height: 40rpx;
  line-height: 40rpx;
  text-align: center;
  background: linear-gradient(135deg, #00F0FF 0%, #FF0080 100%);
  color: #0A0E27;
  font-size: 24rpx;
  font-weight: bold;
  border-radius: 50%;
  flex-shrink: 0;
}

.info-text {
  font-size: 26rpx;
  color: #b8c5d9;
}
