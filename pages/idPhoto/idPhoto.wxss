/* 证件照制作 —— 赛博朋克主题，与全局一致 */
.wrap { padding: 32rpx; background: #0A0E27; min-height: 100vh; box-sizing: border-box; }
.title { color: var(--color-neon-cyan, #00F0FF); font-size: 40rpx; font-weight: bold; }
.desc { color: #9BA8C7; font-size: 24rpx; line-height: 1.5; margin: 12rpx 0 32rpx; }
.section { margin-bottom: 28rpx; }
.section-title { color: #DCE6FF; font-size: 26rpx; margin-bottom: 14rpx; }
.chips { display: flex; flex-wrap: wrap; gap: 16rpx; }
.chip { padding: 14rpx 28rpx; border-radius: 999rpx; background: rgba(255,255,255,0.06); color: #9BA8C7; font-size: 26rpx; border: 2rpx solid transparent; }
.chip-on { background: rgba(0,240,255,0.12); color: #00F0FF; border-color: rgba(0,240,255,0.6); box-shadow: 0 0 10rpx rgba(0,240,255,0.3); }
.btn { margin-top: 12rpx; background: linear-gradient(135deg, #00F0FF, #FF0080); color: #0A0E27; border-radius: 12rpx; font-weight: bold; }
.status { margin-top: 24rpx; font-size: 26rpx; padding: 16rpx; border-radius: 8rpx; }
.status.ok { color: #00FF88; background: rgba(0,255,136,0.08); }
.status.warn { color: #FFB300; background: rgba(255,179,0,0.08); }
.block { margin-top: 32rpx; padding: 20rpx; background: rgba(255,255,255,0.04); border-radius: 12rpx; }
.block-title { color: #FF0080; font-size: 26rpx; font-weight: bold; margin-bottom: 16rpx; }
.logs { max-height: 520rpx; overflow-y: auto; background: #000; border-radius: 8rpx; padding: 16rpx; }
.logline { color: #00FF88; font-size: 22rpx; line-height: 1.6; font-family: monospace; word-break: break-all; }
.result-img { width: 100%; border-radius: 8rpx; background: #000; }
.save-btn { margin-top: 20rpx; }
/* 离屏工作画布：合成 + 导出用，渲染但不可见（canvas 2d 节点需在布局内才能取到 node） */
.work-canvas { position: fixed; left: -9999px; top: 0; width: 200px; height: 280px; }
