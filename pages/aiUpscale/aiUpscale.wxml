<!--pages/aiUpscale/aiUpscale.wxml-->
<view class="container">
  <view class="page-header">
    <text class="page-title">AI 图片放大</text>
    <text class="page-subtitle">2x / 4x 超分辨率，可选降噪锐化</text>
  </view>

  <!-- Step 1: 选择图片 -->
  <view class="step-section" wx:if="{{!imageSrc}}">
    <view class="upload-box" bindtap="chooseImage">
      <view class="upload-icon">+</view>
      <text class="upload-text">点击选择图片</text>
      <text class="upload-hint">支持 JPG / PNG，最长边自动限制 1440px</text>
    </view>
  </view>

  <!-- Step 2: 选项 + 放大 -->
  <view class="step-section" wx:if="{{imageSrc && !resultSrc}}">
    <view class="preview-box" bindtap="previewOriginal">
      <image class="preview-image" src="{{imageSrc}}" mode="aspectFit" />
    </view>

    <!-- 放大倍数 -->
    <view class="opt-group">
      <text class="opt-title">放大倍数</text>
      <view class="scale-row">
        <view class="scale-item {{scale === 2 ? 'active' : ''}}" data-scale="2" bindtap="selectScale">
          <text class="scale-num">2x</text>
          <text class="scale-desc">翻倍</text>
        </view>
        <view class="scale-item {{scale === 4 ? 'active' : ''}}" data-scale="4" bindtap="selectScale">
          <text class="scale-num">4x</text>
          <text class="scale-desc">四倍</text>
        </view>
      </view>
    </view>

    <!-- 增强项 -->
    <view class="opt-group">
      <text class="opt-title">基础增强（可选，放大前作用于原图）</text>
      <view class="enhance-row">
        <view class="enhance-item {{denoise ? 'active' : ''}}" bindtap="toggleDenoise">
          <text class="enhance-icon">✨</text>
          <text class="enhance-name">降噪</text>
          <text class="enhance-state">{{denoise ? '已开' : '关闭'}}</text>
        </view>
        <view class="enhance-item {{sharpen ? 'active' : ''}}" bindtap="toggleSharpen">
          <text class="enhance-icon">💎</text>
          <text class="enhance-name">锐化</text>
          <text class="enhance-state">{{sharpen ? '已开' : '关闭'}}</text>
        </view>
      </view>
    </view>

    <!-- 放大按钮 -->
    <view class="action-section">
      <button class="btn-repair" bindtap="startUpscale" disabled="{{processing}}">
        <text wx:if="{{!processing}}">🔍 开始 AI 放大</text>
        <text wx:else>处理中 {{progress}}%</text>
      </button>
      <text class="status-text" wx:if="{{processing}}">{{statusText}}</text>
      <view class="progress-bar" wx:if="{{processing}}">
        <view class="progress-inner" style="width: {{progress}}%;"></view>
      </view>
    </view>

    <!-- 错误提示 -->
    <view class="error-banner" wx:if="{{errorMsg}}">
      <text class="error-icon">⚠️</text>
      <text class="error-text">{{errorMsg}}</text>
    </view>
  </view>

  <!-- Step 3: 结果对比 -->
  <view class="step-section result-section" wx:if="{{resultSrc}}">
    <view class="result-compare">
      <view class="result-item">
        <view class="result-title">原图</view>
        <view class="result-box" bindtap="previewOriginal">
          <image class="result-image" src="{{imageSrc}}" mode="aspectFit" />
        </view>
      </view>
      <view class="result-item">
        <view class="result-title">放大后</view>
        <view class="result-box result-box-after" bindtap="previewResult">
          <image class="result-image" src="{{resultSrc}}" mode="aspectFit" />
          <view class="engine-tag" wx:if="{{engine}}">{{engineText}}</view>
        </view>
      </view>
    </view>

    <view class="scale-tag-row" wx:if="{{resultSrc}}">
      <text class="scale-tag">{{scale}}x 放大{{denoise ? ' · 降噪' : ''}}{{sharpen ? ' · 锐化' : ''}}</text>
    </view>

    <!-- 降级提示 -->
    <view class="degrade-banner" wx:if="{{degraded}}">
      <text class="degrade-icon">ℹ️</text>
      <text class="degrade-text">{{degradeReason}}</text>
    </view>

    <!-- 操作按钮 -->
    <view class="result-actions">
      <button class="btn-compare" bindtap="onCompare">对比查看</button>
      <button class="btn-save" bindtap="saveResult">保存到相册</button>
      <button class="btn-retry" bindtap="resetAll">重新处理</button>
    </view>
  </view>

  <!-- 功能说明 -->
  <view class="info-section" wx:if="{{!resultSrc}}">
    <view class="info-title">使用说明</view>
    <view class="info-list">
      <view class="info-item"><text class="info-num">1</text><text class="info-text">选择需要放大的图片（最长边自动限制 1440px）</text></view>
      <view class="info-item"><text class="info-num">2</text><text class="info-text">选择 2x 或 4x 放大倍数</text></view>
      <view class="info-item"><text class="info-num">3</text><text class="info-text">按需开启降噪 / 锐化基础增强</text></view>
      <view class="info-item"><text class="info-num">4</text><text class="info-text">AI 放大耗时约 10-60 秒，请耐心等待</text></view>
    </view>
    <view class="info-note">
      AI 放大基于云端 Real-ESRGAN（付费 API）；云端不可用时自动降级为本地基础放大，并明确提示。
    </view>
  </view>
</view>
