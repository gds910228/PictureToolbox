/* pages/gifEditor/gifEditor.wxss */
.page-container {
  min-height: 100vh;
  padding: var(--space-lg);
  box-sizing: border-box;
  position: relative;
  z-index: 1;
}

/* 页头 */
.page-header { margin-bottom: var(--space-md); }
.header-line {
  width: 64rpx; height: 6rpx;
  background: var(--gradient-neon);
  border-radius: 4rpx;
  margin-bottom: var(--space-sm);
  box-shadow: var(--shadow-neon);
}
.header-title {
  display: block;
  font-family: var(--font-family-display);
  font-size: 44rpx; font-weight: 700;
  color: var(--color-white); letter-spacing: 2rpx;
}
.header-sub {
  display: block; margin-top: 6rpx;
  font-size: 24rpx; color: var(--color-gray-500);
}

.hidden-canvas {
  position: fixed; left: -9999rpx; top: -9999rpx;
  width: 480rpx; height: 480rpx;
}

/* 卡片 */
.section { margin-bottom: var(--space-md); }
.section-title {
  display: flex; align-items: center; justify-content: space-between;
  font-size: 30rpx; font-weight: 600;
  color: var(--color-neon-cyan); margin-bottom: var(--space-sm);
}
.section-count {
  font-size: 24rpx; color: var(--color-gray-500); font-weight: 400;
}

/* 空状态 */
.empty-state {
  display: flex; flex-direction: column; align-items: center; justify-content: center;
  padding: var(--space-xl) var(--space-lg);
  border: 2rpx dashed rgba(0,240,255,0.4); border-radius: var(--radius-md);
  background: rgba(0,240,255,0.04);
}
.empty-state:active { background: rgba(0,240,255,0.1); }
.empty-icon { font-size: 80rpx; margin-bottom: var(--space-sm); }
.empty-text { font-size: 28rpx; color: var(--color-neon-cyan); margin-bottom: var(--space-xs); }
.empty-hint { font-size: 22rpx; color: var(--color-gray-500); }

.hint {
  font-size: 22rpx; color: var(--color-gray-500);
  margin-top: var(--space-sm); line-height: 1.5;
}
.link { color: var(--color-neon-cyan); }

/* 信息行 */
.info-row {
  display: flex; align-items: center; padding: 8rpx 0; font-size: 26rpx;
}
.info-label { width: 100rpx; color: var(--color-gray-500); flex-shrink: 0; }
.info-value { color: var(--color-gray-200); flex: 1; word-break: break-all; }

/* 模式切换 */
.mode-tabs {
  display: flex; gap: 8rpx; margin-top: var(--space-sm);
}
.mode-tab {
  flex: 1; text-align: center; padding: 14rpx 0;
  font-size: 26rpx; color: var(--color-gray-200);
  border-radius: var(--radius-sm);
  border: 2rpx solid rgba(255,255,255,0.12);
  background: rgba(255,255,255,0.03);
  transition: all 0.2s;
}
.mode-tab.active {
  color: var(--color-deep-space);
  background: var(--color-neon-cyan);
  border-color: var(--color-neon-cyan);
  font-weight: 600;
  box-shadow: 0 0 12rpx rgba(0,240,255,0.5);
}

/* 预览 */
.preview-stage {
  position: relative;
  width: 100%;
  border-radius: var(--radius-md);
  overflow: hidden;
  background:
    repeating-conic-gradient(rgba(255,255,255,0.04) 0% 25%, transparent 0% 50%) 0 0 / 32rpx 32rpx;
  display: flex; align-items: center; justify-content: center;
  min-height: 200rpx;
  margin-bottom: var(--space-sm);
}
.canvas-wrap {
  position: relative;
  display: inline-block;
  line-height: 0;
}
.preview-canvas {
  display: block;
  image-rendering: pixelated;
}
.preview-play {
  position: absolute; top: 50%; left: 50%;
  transform: translate(-50%, -50%);
  width: 96rpx; height: 96rpx; border-radius: 50%;
  background: rgba(0,0,0,0.5);
  display: flex; align-items: center; justify-content: center;
  border: 2rpx solid var(--color-neon-cyan);
}
.play-icon { font-size: 36rpx; color: var(--color-neon-cyan); margin-left: 6rpx; }

/* 裁剪覆盖层 */
.crop-overlay {
  position: absolute; top: 0; left: 0;
  width: 100%; height: 100%;
  pointer-events: none;
}
.crop-box {
  position: absolute;
  border: 3rpx solid var(--color-neon-cyan);
  box-shadow: 0 0 16rpx rgba(0,240,255,0.5);
  pointer-events: auto;
}
.crop-move {
  position: absolute; top: 0; left: 0; right: 0; bottom: 0;
}
.crop-handle {
  position: absolute; width: 32rpx; height: 32rpx;
  background: var(--color-neon-cyan);
  border-radius: 50%;
  border: 4rpx solid var(--color-deep-space);
  box-shadow: 0 0 8rpx rgba(0,240,255,0.8);
}
.crop-handle.tl { top: -16rpx; left: -16rpx; }
.crop-handle.tr { top: -16rpx; right: -16rpx; }
.crop-handle.bl { bottom: -16rpx; left: -16rpx; }
.crop-handle.br { bottom: -16rpx; right: -16rpx; }

.crop-controls { margin-top: var(--space-sm); }

/* 擦除控制 */
.erase-controls { margin-top: var(--space-sm); }

/* 通用 chip/按钮行 */
.chip-row {
  display: flex; align-items: center; gap: 12rpx;
  flex-wrap: wrap; margin-bottom: var(--space-sm);
}
.btn-row {
  display: flex; gap: 12rpx; margin-top: var(--space-sm);
}
.btn-sm {
  width: auto !important; height: 64rpx !important;
  line-height: 64rpx !important; font-size: 26rpx !important;
  padding: 0 32rpx !important; border-radius: var(--radius-sm) !important;
}
.btn-sm.disabled { opacity: 0.4; }
.ctrl-label {
  font-size: 24rpx; color: var(--color-gray-500);
  min-width: 80rpx;
}
.ctrl-value { font-size: 22rpx; color: var(--color-neon-cyan); min-width: 60rpx; text-align: right; }

.tool-row {
  display: flex; align-items: center; flex-wrap: wrap;
  gap: 12rpx; padding: var(--space-xs) 0;
}
.tool-label {
  width: 120rpx; font-size: 26rpx; color: var(--color-gray-200); flex-shrink: 0;
}
.tool-actions { display: flex; align-items: center; gap: 12rpx; flex-wrap: wrap; }
.tool-chip {
  padding: 10rpx 24rpx; border-radius: var(--radius-sm);
  font-size: 24rpx; color: var(--color-gray-200);
  border: 2rpx solid rgba(255,255,255,0.12);
  background: rgba(255,255,255,0.03);
}
.tool-chip.active {
  color: var(--color-deep-space); background: var(--color-neon-cyan);
  border-color: var(--color-neon-cyan);
  box-shadow: 0 0 12rpx rgba(0,240,255,0.5); font-weight: 600;
}
.tool-chip.danger {
  color: var(--color-hot-magenta);
  border-color: rgba(255,0,128,0.4);
  background: rgba(255,0,128,0.06);
}
.tool-chip.danger.disabled { opacity: 0.35; }

.tool-range {
  display: flex; align-items: center; gap: 12rpx; flex-wrap: wrap;
}
.range-field { display: flex; align-items: center; gap: 8rpx; }
.range-text { font-size: 24rpx; color: var(--color-gray-500); }
.range-value {
  min-width: 56rpx; text-align: center; padding: 8rpx 16rpx;
  border-radius: var(--radius-sm); font-size: 24rpx;
  color: var(--color-neon-cyan);
  border: 2rpx solid rgba(0,240,255,0.3);
  background: rgba(0,240,255,0.06);
}
.range-value-sm {
  min-width: 48rpx; text-align: center; padding: 6rpx 12rpx;
  border-radius: var(--radius-sm); font-size: 22rpx;
  color: var(--color-neon-cyan);
  border: 2rpx solid rgba(0,240,255,0.3);
  background: rgba(0,240,255,0.06);
}
.range-sep { font-size: 24rpx; color: var(--color-gray-500); }

/* 文字覆盖层（预览中的可拖拽文字） */
.text-overlay {
  position: absolute;
  pointer-events: auto;
  font-weight: bold;
  white-space: pre;
  text-shadow: 0 0 4rpx rgba(0,0,0,0.8);
  padding: 4rpx;
}
.text-overlay.editing {
  outline: 2rpx dashed var(--color-neon-cyan);
  background: rgba(0,240,255,0.1);
}

/* 文字列表面板 */
.text-list { max-height: 300rpx; margin-bottom: var(--space-sm); }
.text-item {
  display: flex; align-items: center; gap: 12rpx;
  padding: 16rpx; margin-bottom: 8rpx;
  border-radius: var(--radius-sm);
  background: rgba(255,255,255,0.04);
  border: 2rpx solid transparent;
}
.text-item.editing {
  border-color: var(--color-neon-cyan);
  background: rgba(0,240,255,0.08);
}
.text-item-content { flex: 1; font-size: 28rpx; font-weight: 600; }
.text-item-meta { font-size: 20rpx; color: var(--color-gray-500); }
.text-item-del {
  font-size: 36rpx; color: var(--color-hot-magenta);
  padding: 0 8rpx;
}

.text-form {
  padding-top: var(--space-sm);
  border-top: 1rpx solid rgba(255,255,255,0.08);
}
.text-input {
  width: 100%; min-height: 72rpx; box-sizing: border-box;
  padding: 12rpx 20rpx; border-radius: var(--radius-sm);
  background: rgba(255,255,255,0.05);
  border: 2rpx solid rgba(0,240,255,0.2);
  color: var(--color-white); font-size: 28rpx;
  margin-bottom: var(--space-sm);
}
.form-row {
  display: flex; align-items: center; gap: 12rpx;
  margin-bottom: var(--space-sm); flex-wrap: wrap;
}
.chip-group { display: flex; gap: 8rpx; flex-wrap: wrap; }
.color-chip {
  width: 48rpx; height: 48rpx; border-radius: 50%;
  border: 3rpx solid rgba(255,255,255,0.2);
}
.color-chip.active {
  border-color: var(--color-white);
  box-shadow: 0 0 12rpx rgba(255,255,255,0.5);
  transform: scale(1.15);
}
.opacity-slider { flex: 1; }
.range-fields { display: flex; align-items: center; gap: 8rpx; }

.grid-picker {
  display: grid; grid-template-columns: repeat(3, 1fr);
  gap: 6rpx; width: 180rpx;
}
.grid-pos {
  text-align: center; padding: 10rpx 0;
  font-size: 24rpx; border-radius: var(--radius-sm);
  background: rgba(255,255,255,0.04);
  border: 2rpx solid transparent;
  color: var(--color-gray-200);
}
.grid-pos.active {
  background: rgba(0,240,255,0.15);
  border-color: var(--color-neon-cyan);
  color: var(--color-neon-cyan);
}

/* 帧列表 */
.thumb-strip { width: 100%; white-space: nowrap; }
.thumb-list {
  display: inline-flex; align-items: flex-start;
  gap: 16rpx; padding: 4rpx;
}
.thumb {
  position: relative; width: 140rpx; border-radius: var(--radius-md);
  overflow: hidden; border: 3rpx solid rgba(255,255,255,0.1);
  flex-shrink: 0; background: rgba(0,0,0,0.3);
  transition: border-color 0.2s;
}
.thumb.selected {
  border-color: var(--color-neon-cyan);
  box-shadow: 0 0 16rpx rgba(0,240,255,0.5);
}
.thumb-img { width: 100%; height: 140rpx; }
.thumb-placeholder {
  width: 100%; height: 140rpx;
  display: flex; align-items: center; justify-content: center;
  color: var(--color-gray-500); font-size: 24rpx;
}
.thumb-order {
  position: absolute; left: 6rpx; top: 6rpx;
  min-width: 28rpx; height: 28rpx; line-height: 28rpx;
  padding: 0 8rpx; border-radius: 14rpx;
  font-size: 20rpx; color: var(--color-deep-space);
  background: var(--color-neon-cyan); text-align: center;
}
.thumb-delay {
  position: absolute; left: 0; right: 0; bottom: 0;
  height: 32rpx; line-height: 32rpx; text-align: center;
  font-size: 18rpx; color: var(--color-white);
  background: rgba(0,0,0,0.6);
}
.thumb-check {
  position: absolute; top: 6rpx; right: 6rpx;
  width: 32rpx; height: 32rpx; line-height: 32rpx;
  text-align: center; font-size: 22rpx;
  color: var(--color-white); background: var(--color-hot-magenta);
  border-radius: 50%;
}

/* 生成按钮 */
.generate-btn { font-size: 34rpx; letter-spacing: 2rpx; }
.generate-btn.loading { opacity: 0.85; }
.generate-btn[disabled] { opacity: 0.4; }

.progress-wrap {
  display: flex; align-items: center; gap: 16rpx;
  margin-top: var(--space-sm);
}
.progress-bar {
  flex: 1; height: 12rpx; border-radius: 6rpx;
  background: rgba(255,255,255,0.08); overflow: hidden;
}
.progress-fill {
  height: 100%;
  background: var(--gradient-neon);
  border-radius: 6rpx;
  transition: width 0.2s;
}
.progress-text {
  font-size: 24rpx; color: var(--color-neon-cyan);
  min-width: 64rpx; text-align: right;
}

/* 草稿恢复 */
.draft-banner {
  border-left: 6rpx solid var(--color-neon-cyan);
}
.draft-row {
  display: flex; align-items: center; justify-content: space-between;
}
.draft-text { font-size: 26rpx; color: var(--color-gray-200); }
.draft-actions { display: flex; gap: 24rpx; }
.link.danger { color: var(--color-hot-magenta); }

/* 导出区 */
.export-row { margin-top: var(--space-sm); }
.cross-link {
  display: block; text-align: center; margin-top: var(--space-md);
  font-size: 24rpx; color: var(--color-gray-500);
}

/* 信息面板 */
.info-panel { }
.info-grid {
  display: grid; grid-template-columns: repeat(2, 1fr);
  gap: 16rpx;
}
.info-cell {
  display: flex; flex-direction: column; gap: 4rpx;
  padding: 16rpx; border-radius: var(--radius-sm);
  background: rgba(255,255,255,0.04);
}
.info-cell-label {
  font-size: 22rpx; color: var(--color-gray-500);
}
.info-cell-value {
  font-size: 28rpx; color: var(--color-white); font-weight: 600;
}

/* 目标压缩（导出卡片） */
.compress-row { gap: 12rpx; }
.size-input {
  width: 100rpx; height: 56rpx; text-align: center;
  background: rgba(255,255,255,0.08);
  border-radius: var(--radius-sm);
  color: var(--color-white); font-size: 26rpx;
}
.unit-chip {
  min-width: 56rpx; height: 56rpx; padding: 0 12rpx; box-sizing: border-box;
  display: flex; align-items: center; justify-content: center;
  font-size: 24rpx; color: var(--color-gray-500);
  background: rgba(255,255,255,0.08);
  border: 1rpx solid rgba(255,255,255,0.12);
  border-radius: var(--radius-sm);
}
.unit-chip.active {
  color: var(--color-neon-cyan);
  border-color: var(--color-neon-cyan);
  background: rgba(0, 240, 255, 0.1);
}

/* 结果 */
.preview-wrap {
  width: 100%; border-radius: var(--radius-md); overflow: hidden;
  background:
    repeating-conic-gradient(rgba(255,255,255,0.04) 0% 25%, transparent 0% 50%) 0 0 / 32rpx 32rpx;
  display: flex; align-items: center; justify-content: center;
  min-height: 200rpx; margin-bottom: var(--space-sm);
}
.preview-img { width: 100%; max-height: 600rpx; }
.result-meta {
  font-size: 24rpx; color: var(--color-gray-500);
  margin-bottom: var(--space-sm);
}
.save-btn { margin-top: 0; }
.result-actions { display: flex; gap: 12rpx; margin-top: var(--space-sm); }
.result-actions .btn-sm { flex: 1; }
.result-links {
  display: flex; gap: 24rpx; justify-content: center;
  margin-top: var(--space-md); font-size: 24rpx;
}
.result-link { color: var(--color-gray-500); }
