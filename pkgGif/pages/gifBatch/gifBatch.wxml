<!-- pages/gifBatch/gifBatch.wxml -->
<view class="page-container">

  <view class="page-header">
    <view class="header-line"></view>
    <text class="header-title">GIF 批量处理</text>
    <text class="header-sub">多选 GIF · 调速/倒放/压缩/裁剪 · 串行本地处理</text>
  </view>

  <!-- 选择文件 -->
  <view class="card section">
    <view class="section-title">
      <text>文件队列</text>
      <text class="section-count">{{files.length}}/{{maxFiles}}</text>
    </view>
    <view class="add-btn" bindtap="chooseGif" wx:if="{{files.length < maxFiles}}">
      <text class="add-icon">+</text>
      <text>从聊天导入 GIF</text>
    </view>
    <view class="source-actions" wx:if="{{files.length < maxFiles}}">
      <button class="btn btn-secondary source-btn" bindtap="chooseFromAlbum">从相册试试</button>
      <button class="btn btn-secondary source-btn" bindtap="showImportGuide">导入指引</button>
    </view>
    <view class="hint import-hint" wx:if="{{files.length < maxFiles}}">提示：把 .gif 以「文件」发到聊天（如文件传输助手）后导入最稳妥；相册直接选图可能被微信转成静态 JPG。</view>

    <!-- 文件列表 -->
    <view class="file-list" wx:if="{{files.length > 0}}">
      <view wx:for="{{files}}" wx:key="id" class="file-card status-{{item.status}}">
        <view class="file-info">
          <text class="file-name">{{item.name}}</text>
          <text class="file-meta">
            {{item.sizeText}}
            <text wx:if="{{item.frameCount > 0}}"> · {{item.width}}×{{item.height}} · {{item.frameCount}}帧</text>
            <text wx:if="{{item.outputSizeText}}"> → {{item.outputSizeText}}</text>
          </text>
          <text class="file-error" wx:if="{{item.error}}">{{item.error}}</text>
        </view>
        <view class="file-status">
          <text wx:if="{{item.status === 'decoding'}}" class="status-text">解码中...</text>
          <text wx:elif="{{item.status === 'ready'}}" class="status-text ready">就绪</text>
          <text wx:elif="{{item.status === 'processing'}}" class="status-text">处理中</text>
          <text wx:elif="{{item.status === 'done'}}" class="status-text done" data-id="{{item.id}}" bindtap="saveOne">保存</text>
          <text wx:elif="{{item.status === 'failed'}}" class="status-text fail" data-id="{{item.id}}" bindtap="retryFile">重试</text>
          <text class="file-remove" data-id="{{item.id}}" catchtap="removeFile">×</text>
        </view>
      </view>
    </view>
  </view>

  <!-- 批量设置 -->
  <view class="card section" wx:if="{{files.length > 0}}">
    <view class="section-title"><text>批量操作</text></view>

    <view class="tool-row">
      <view class="tool-label">调速</view>
      <view class="tool-actions">
        <view wx:for="{{speedOptions}}" wx:key="value"
              class="tool-chip {{speedIndex === index ? 'active' : ''}}"
              data-index="{{index}}" bindtap="setSpeed">{{item.label}}</view>
      </view>
    </view>

    <view class="tool-row">
      <view class="tool-label">裁剪比例</view>
      <view class="tool-actions">
        <view wx:for="{{cropRatios}}" wx:key="label"
              class="tool-chip {{cropIndex === index ? 'active' : ''}}"
              data-index="{{index}}" bindtap="setCrop">{{item.label}}</view>
      </view>
    </view>

    <view class="tool-row">
      <view class="tool-label">倒放</view>
      <view class="tool-actions">
        <view class="tool-chip {{reverseAll ? 'active' : ''}}" bindtap="toggleReverse">
          {{reverseAll ? '已开启' : '关闭'}}
        </view>
      </view>
    </view>

    <view class="tool-row">
      <view class="tool-label">压缩到</view>
      <view class="tool-actions compress-row">
        <switch checked="{{compressEnabled}}" bindchange="toggleCompress" color="#00F0FF"/>
        <input class="size-input" type="digit" value="{{targetSize}}"
               bindinput="onTargetSize" disabled="{{!compressEnabled}}"/>
        <view class="unit-chip {{sizeUnit === 'KB' ? 'active' : ''}}"
              data-unit="KB" bindtap="setSizeUnit">KB</view>
        <view class="unit-chip {{sizeUnit === 'MB' ? 'active' : ''}}"
              data-unit="MB" bindtap="setSizeUnit">MB</view>
      </view>
    </view>
  </view>

  <!-- 处理进度 -->
  <view class="card section" wx:if="{{processing || overallProgress > 0}}">
    <view class="progress-wrap">
      <view class="progress-bar"><view class="progress-fill" style="width: {{overallProgress}}%"></view></view>
      <text class="progress-text">{{overallProgress}}%</text>
    </view>
    <text class="hint">{{overallText}}</text>
    <text class="hint" wx:if="{{totalDone + totalFailed > 0}}">
      成功 {{totalDone}} · 失败 {{totalFailed}}
    </text>
  </view>

  <!-- 执行按钮 -->
  <view class="card section" wx:if="{{files.length > 0}}">
    <button class="btn btn-primary generate-btn {{processing ? 'loading' : ''}}"
            disabled="{{processing}}" bindtap="processAll">
      {{processing ? '处理中...' : '开始批量处理'}}
    </button>
    <button class="btn btn-secondary save-btn" wx:if="{{totalDone > 0}}" bindtap="saveAll">
      全部保存到相册
    </button>
    <navigator url="/pkgGif/pages/makeGif/makeGif" class="cross-link" hover-class="none">
      <text>💡 需要图片合成 GIF？前往 GIF制作 →</text>
    </navigator>
  </view>

</view>
