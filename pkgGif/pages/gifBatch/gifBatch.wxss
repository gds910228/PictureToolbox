/* pages/gifBatch/gifBatch.wxss */
.page-container {
  min-height: 100vh;
  padding: var(--space-lg);
  box-sizing: border-box;
  position: relative;
  z-index: 1;
}
.page-header { margin-bottom: var(--space-md); }
.header-line {
  width: 64rpx; height: 6rpx;
  background: var(--gradient-neon);
  border-radius: 4rpx;
  margin-bottom: var(--space-sm);
  box-shadow: var(--shadow-neon);
}
.header-title {
  display: block;
  font-family: var(--font-family-display);
  font-size: 44rpx; font-weight: 700;
  color: var(--color-white); letter-spacing: 2rpx;
}
.header-sub {
  display: block; margin-top: 6rpx;
  font-size: 24rpx; color: var(--color-gray-500);
}
.card {
  background: rgba(255,255,255,0.05);
  border-radius: var(--radius-lg);
  padding: var(--space-lg);
  margin-bottom: var(--space-md);
  border: 1rpx solid rgba(255,255,255,0.1);
}
.section-title {
  display: flex; align-items: center; justify-content: space-between;
  font-size: 30rpx; font-weight: 600;
  color: var(--color-neon-cyan); margin-bottom: var(--space-sm);
}
.section-count { font-size: 24rpx; color: var(--color-gray-500); font-weight: 400; }

.add-btn {
  display: flex; align-items: center; justify-content: center; gap: 12rpx;
  padding: var(--space-lg);
  border: 2rpx dashed rgba(0,240,255,0.4);
  border-radius: var(--radius-md);
  color: var(--color-neon-cyan); font-size: 28rpx;
}
.add-btn:active { background: rgba(0,240,255,0.1); }
.add-icon { font-size: 40rpx; }

/* 辅助入口行：相册尝试 + 导入指引 */
.source-actions {
  display: flex; gap: var(--space-sm); margin-top: var(--space-sm);
}
.source-btn { flex: 1; height: 72rpx; line-height: 72rpx; font-size: 26rpx; }
.import-hint { margin-top: var(--space-sm); }

.file-list { margin-top: var(--space-md); }
.file-card {
  display: flex; align-items: center; justify-content: space-between;
  padding: var(--space-md);
  margin-bottom: var(--space-sm);
  border-radius: var(--radius-sm);
  background: rgba(255,255,255,0.04);
  border-left: 6rpx solid var(--color-gray-500);
}
.file-card.status-ready { border-left-color: var(--color-neon-cyan); }
.file-card.status-done { border-left-color: #4caf50; }
.file-card.status-failed { border-left-color: var(--color-hot-magenta); }
.file-card.status-processing { border-left-color: var(--color-solar-flare); }
.file-info { flex: 1; min-width: 0; }
.file-name {
  display: block; font-size: 26rpx; color: var(--color-white);
  overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
}
.file-meta { display: block; font-size: 22rpx; color: var(--color-gray-500); margin-top: 4rpx; }
.file-error { display: block; font-size: 22rpx; color: var(--color-hot-magenta); margin-top: 4rpx; }
.file-status { display: flex; align-items: center; gap: 16rpx; flex-shrink: 0; }
.status-text { font-size: 24rpx; color: var(--color-gray-500); }
.status-text.ready { color: var(--color-neon-cyan); }
.status-text.done { color: #4caf50; }
.status-text.fail { color: var(--color-hot-magenta); }
.file-remove { font-size: 36rpx; color: var(--color-gray-500); padding: 0 8rpx; }

.tool-row {
  display: flex; align-items: center; flex-wrap: wrap;
  gap: 12rpx; padding: var(--space-xs) 0;
}
.tool-label {
  width: 120rpx; font-size: 26rpx; color: var(--color-gray-200); flex-shrink: 0;
}
.tool-actions { display: flex; align-items: center; gap: 12rpx; flex-wrap: wrap; }
.tool-chip {
  padding: 10rpx 24rpx; border-radius: var(--radius-sm);
  font-size: 24rpx; color: var(--color-gray-200);
  border: 2rpx solid rgba(255,255,255,0.12);
  background: rgba(255,255,255,0.03);
}
.tool-chip.active {
  color: var(--color-deep-space);
  background: var(--color-neon-cyan);
  border-color: var(--color-neon-cyan);
  font-weight: 600;
  box-shadow: 0 0 12rpx rgba(0,240,255,0.5);
}
.compress-row { gap: 12rpx; }
.size-input {
  width: 100rpx; height: 56rpx; text-align: center;
  background: rgba(255,255,255,0.08);
  border-radius: var(--radius-sm);
  color: var(--color-white); font-size: 26rpx;
}
.unit-chip {
  min-width: 56rpx; height: 56rpx; padding: 0 12rpx; box-sizing: border-box;
  display: flex; align-items: center; justify-content: center;
  font-size: 24rpx; color: var(--color-gray-500);
  background: rgba(255,255,255,0.08);
  border: 1rpx solid rgba(255,255,255,0.12);
  border-radius: var(--radius-sm);
}
.unit-chip.active {
  color: var(--color-neon-cyan);
  border-color: var(--color-neon-cyan);
  background: rgba(0, 240, 255, 0.1);
}

.progress-wrap {
  display: flex; align-items: center; gap: 16rpx; margin: var(--space-sm) 0;
}
.progress-bar {
  flex: 1; height: 12rpx; border-radius: 6rpx;
  background: rgba(255,255,255,0.08); overflow: hidden;
}
.progress-fill {
  height: 100%;
  background: var(--gradient-neon);
  border-radius: 6rpx;
  transition: width 0.2s;
}
.progress-text { font-size: 24rpx; color: var(--color-neon-cyan); min-width: 64rpx; text-align: right; }

.hint { font-size: 22rpx; color: var(--color-gray-500); line-height: 1.5; }
.generate-btn { font-size: 34rpx; letter-spacing: 2rpx; }
.generate-btn.loading { opacity: 0.85; }
.save-btn { margin-top: var(--space-sm); }
.cross-link {
  display: block; text-align: center; margin-top: var(--space-md);
  font-size: 24rpx; color: var(--color-gray-500);
}
